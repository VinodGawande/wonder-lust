<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create your WonderLust account | Sign Up</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@1,600&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            serif: ['"Playfair Display"', 'serif'],
          }
        }
      }
    }
  </script>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
  <style>
    .glass-panel-dark {
      background: rgba(15, 23, 42, 0.45);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
  </style>
</head>
<body class="bg-[#d5dbe4] text-slate-800 antialiased font-sans min-h-screen flex items-center justify-center p-3 sm:p-6 lg:p-8">

  <!-- Main Split Layout Container -->
  <div class="relative w-full max-w-[1360px] min-h-[780px] lg:h-[880px] bg-[#eef1f6] rounded-[2.5rem] shadow-[0_25px_70px_rgba(0,0,0,0.18)] overflow-hidden flex flex-col lg:flex-row">
    
    <!-- ========================================== -->
    <!-- LEFT PANEL: HERO VISUAL & BRAND STORY      -->
    <!-- ========================================== -->
    <div class="relative w-full lg:w-[52%] min-h-[500px] lg:min-h-full p-8 sm:p-12 lg:p-14 flex flex-col justify-between text-white overflow-hidden">
      
      <!-- Background Sunset Villa Pool Image -->
      <img 
        src="https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?auto=format&fit=crop&w=2000&q=85" 
        alt="Santorini Sunset Pool Villa" 
        class="absolute inset-0 w-full h-full object-cover object-center z-0"
      />
      <!-- Gradient Overlays for Readability -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-black/40 z-10"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-black/50 via-transparent to-transparent z-10"></div>

      <!-- Top Brand Logo -->
      <div class="relative z-20 flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-full border-2 border-[#ff4757] flex items-center justify-center relative p-1 bg-white/10 backdrop-blur-sm">
          <svg viewBox="0 0 24 24" fill="none" class="w-full h-full text-[#ff4757]">
            <circle cx="12" cy="12" r="9" stroke="#ff4757" stroke-width="1.8" />
            <polygon points="12,3 14.5,9.5 21,12 14.5,14.5 12,21 9.5,14.5 3,12 9.5,9.5" fill="#ff4757" />
            <circle cx="18" cy="18" r="2.2" fill="#ffffff" />
          </svg>
        </div>
        <span class="text-2xl font-bold tracking-tight text-white font-sans drop-shadow-sm">
          Wonder<span class="text-[#ff4757]">Lust</span>
        </span>
      </div>

      <!-- Mid Hero Copy (Matching Reference Image) -->
      <div class="relative z-20 my-auto py-6 max-w-lg">
        <span class="block text-[11px] font-bold uppercase tracking-[0.3em] text-white/90 mb-3 drop-shadow">
          EXPLORE &nbsp;·&nbsp; STAY &nbsp;·&nbsp; EXPERIENCE
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-[1.06] text-white drop-shadow-md">
          Travel more.<br>
          <span class="bg-gradient-to-r from-[#ff4757] via-[#ff6b81] to-[#ff7f50] bg-clip-text text-transparent">Experience</span><br>
          more.
        </h1>
        <p class="text-xs sm:text-sm text-white/90 mt-5 font-normal leading-relaxed max-w-md drop-shadow">
          Join millions of travelers discovering extraordinary stays and unforgettable experiences around the world.
        </p>
      </div>

      <!-- Bottom Glass Stats & Testimonial -->
      <div class="relative z-20 space-y-4">
        
        <!-- Stats Strip -->
        <div class="glass-panel-dark rounded-2xl border border-white/20 px-5 py-3.5 flex items-center justify-between text-white/95">
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-house text-[#ff6b81] text-xs"></i>
            <div>
              <span class="block text-xs font-extrabold leading-none">50K+</span>
              <span class="text-[10px] text-white/70">Unique homes</span>
            </div>
          </div>
          <div class="h-6 w-[1px] bg-white/20"></div>
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-location-dot text-[#ff6b81] text-xs"></i>
            <div>
              <span class="block text-xs font-extrabold leading-none">100+</span>
              <span class="text-[10px] text-white/70">Countries</span>
            </div>
          </div>
          <div class="h-6 w-[1px] bg-white/20"></div>
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-star text-amber-400 text-xs"></i>
            <div>
              <span class="block text-xs font-extrabold leading-none">4.9</span>
              <span class="text-[10px] text-white/70">Guest satisfaction</span>
            </div>
          </div>
        </div>

        <!-- Testimonial (Europe Trip - Priya S.) -->
        <div class="glass-panel-dark rounded-2xl border border-white/20 p-4 flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="flex -space-x-2 overflow-hidden shrink-0">
              <img class="inline-block h-8 w-8 rounded-full ring-2 ring-white/50 object-cover" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=120&q=80" alt="Priya">
              <img class="inline-block h-8 w-8 rounded-full ring-2 ring-white/50 object-cover" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&q=80" alt="David">
              <img class="inline-block h-8 w-8 rounded-full ring-2 ring-white/50 object-cover" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80" alt="Sarah">
            </div>
            <div>
              <p class="text-xs text-white/95 font-medium leading-tight">"WonderLust made our Europe trip unforgettable!"</p>
              <div class="flex items-center gap-1.5 mt-1">
                <span class="text-[10px] text-white/70">– Priya S.</span>
                <div class="flex text-[9px] text-amber-400">
                  <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                </div>
              </div>
            </div>
          </div>

          <!-- Carousel Controls -->
          <div class="flex items-center gap-2 shrink-0">
            <div class="flex items-center gap-1">
              <span class="w-5 h-1 rounded-full bg-white"></span>
              <span class="w-2 h-1 rounded-full bg-white/40"></span>
              <span class="w-2 h-1 rounded-full bg-white/40"></span>
            </div>
            <button type="button" class="w-6 h-6 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white text-[10px] transition-colors"><i class="fa-solid fa-chevron-left"></i></button>
            <button type="button" class="w-6 h-6 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white text-[10px] transition-colors"><i class="fa-solid fa-chevron-right"></i></button>
          </div>

        </div>

      </div>

    </div>

    <!-- ========================================== -->
    <!-- RIGHT PANEL: SIGN UP FORM                 -->
    <!-- ========================================== -->
    <div class="relative w-full lg:w-[48%] min-h-full p-6 sm:p-10 lg:p-12 flex flex-col justify-between bg-gradient-to-br from-[#f8fafc]/90 via-[#f1f5f9]/70 to-[#e2e8f0]/80 overflow-y-auto">
      
      <!-- Decorative Floating Travel Polaroid Cards (Right Edge) -->
      <div class="absolute -right-6 top-8 w-36 h-48 bg-white p-2.5 rounded-2xl shadow-xl transform rotate-6 hidden sm:block pointer-events-none opacity-80 border border-slate-200/60 z-0">
        <div class="w-full h-28 bg-rose-50 rounded-xl flex items-center justify-center text-rose-300 text-3xl font-serif">✳</div>
        <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mt-3 text-center">EXPLORE<br>DREAM<br>DISCOVER</p>
      </div>
      <div class="absolute -right-4 bottom-14 w-40 bg-white p-3 rounded-2xl shadow-2xl transform -rotate-3 hidden sm:block pointer-events-none opacity-90 border border-slate-200/60 z-0">
        <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=400&q=80" alt="Beach preview" class="w-full h-24 object-cover rounded-xl mb-2">
        <p class="text-[10px] font-bold text-slate-700 leading-tight">Good Places<br><span class="text-slate-400 font-normal">Good People</span></p>
        <span class="text-[9px] text-[#ff4757] block mt-1">❤</span>
      </div>

      <!-- Top Back To Home Button -->
      <div class="flex justify-end relative z-20">
        <a href="/" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/90 hover:bg-white text-slate-700 hover:text-slate-900 border border-slate-200 shadow-sm text-xs font-semibold transition-all active:scale-95 text-decoration-none">
          <i class="fa-solid fa-house text-slate-400 text-[11px]"></i>
          <span>Back to Home</span>
        </a>
      </div>

      <!-- Form Container -->
      <div class="relative z-20 my-auto py-2 max-w-md w-full mx-auto">
        
        <!-- Heading -->
        <div class="mb-5">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight">
            Create your<br>
            Wonder<span class="text-[#ff4757]">Lust</span> account
          </h2>
          <p class="text-xs text-slate-500 mt-1 font-normal leading-relaxed">
            Start your journey to extraordinary stays and unforgettable experiences.
          </p>
        </div>

        <!-- Flash Messages -->
        <% if(typeof error !== 'undefined' && error && error.length > 0) { %>
          <div class="mb-4 p-3 rounded-2xl bg-rose-50 border border-rose-200 text-rose-600 text-xs font-semibold flex items-center gap-2">
            <i class="fa-solid fa-circle-exclamation text-sm"></i>
            <span><%= error %></span>
          </div>
        <% } %>
        <% if(typeof success !== 'undefined' && success && success.length > 0) { %>
          <div class="mb-4 p-3 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-600 text-xs font-semibold flex items-center gap-2">
            <i class="fa-solid fa-circle-check text-sm"></i>
            <span><%= success %></span>
          </div>
        <% } %>

        <!-- Sign Up Form -->
        <form action="/signup" method="POST" id="signupForm" class="space-y-3.5">
          
          <!-- First Name & Last Name (2 Cols) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">First name</label>
              <div class="relative flex items-center">
                <span class="absolute left-3.5 text-slate-400 pointer-events-none">
                  <i class="fa-regular fa-user text-xs"></i>
                </span>
                <input 
                  type="text" 
                  name="firstName" 
                  required 
                  placeholder="Enter your first name"
                  class="w-full bg-white border border-slate-200/90 rounded-2xl pl-10 pr-3.5 py-2.5 text-xs text-slate-800 placeholder-slate-400 font-medium shadow-sm focus:outline-none focus:border-[#ff4757] focus:ring-2 focus:ring-[#ff4757]/10 transition-all"
                >
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Last name</label>
              <div class="relative flex items-center">
                <span class="absolute left-3.5 text-slate-400 pointer-events-none">
                  <i class="fa-regular fa-user text-xs"></i>
                </span>
                <input 
                  type="text" 
                  name="lastName" 
                  required 
                  placeholder="Enter your last name"
                  class="w-full bg-white border border-slate-200/90 rounded-2xl pl-10 pr-3.5 py-2.5 text-xs text-slate-800 placeholder-slate-400 font-medium shadow-sm focus:outline-none focus:border-[#ff4757] focus:ring-2 focus:ring-[#ff4757]/10 transition-all"
                >
              </div>
            </div>
          </div>

          <!-- Email Address (also used as username in Passport) -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Email address</label>
            <div class="relative flex items-center">
              <span class="absolute left-3.5 text-slate-400 pointer-events-none">
                <i class="fa-regular fa-envelope text-xs"></i>
              </span>
              <input 
                type="email" 
                name="email" 
                id="signupEmail"
                required 
                placeholder="you@example.com"
                autocomplete="email"
                class="w-full bg-white border border-slate-200/90 rounded-2xl pl-10 pr-4 py-2.5 text-xs text-slate-800 placeholder-slate-400 font-medium shadow-sm focus:outline-none focus:border-[#ff4757] focus:ring-2 focus:ring-[#ff4757]/10 transition-all"
              >
            </div>
            <!-- Hidden username field to ensure passport-local compatibility -->
            <input type="hidden" name="username" id="passportUsername">
          </div>

          <!-- Password -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Password</label>
            <div class="relative flex items-center">
              <span class="absolute left-3.5 text-slate-400 pointer-events-none">
                <i class="fa-solid fa-lock text-xs"></i>
              </span>
              <input 
                type="password" 
                name="password" 
                id="passwordField" 
                required 
                placeholder="Create a password"
                autocomplete="new-password"
                class="w-full bg-white border border-slate-200/90 rounded-2xl pl-10 pr-10 py-2.5 text-xs text-slate-800 placeholder-slate-400 font-medium shadow-sm focus:outline-none focus:border-[#ff4757] focus:ring-2 focus:ring-[#ff4757]/10 transition-all"
              >
              <button 
                type="button" 
                id="togglePasswordBtn" 
                class="absolute right-3.5 text-slate-400 hover:text-slate-600 transition-colors"
                tabindex="-1"
              >
                <i id="eyeIcon" class="fa-regular fa-eye-slash text-xs"></i>
              </button>
            </div>

            <!-- Password Helper Badges (Interactive from reference image) -->
            <div class="flex flex-wrap items-center gap-3 mt-1.5 px-1 text-[10px] text-slate-400">
              <span id="chkLength" class="flex items-center gap-1 transition-colors">
                <i class="fa-solid fa-check text-[9px]"></i> At least 8 characters
              </span>
              <span id="chkUpper" class="flex items-center gap-1 transition-colors">
                <i class="fa-solid fa-check text-[9px]"></i> One uppercase letter
              </span>
              <span id="chkNumber" class="flex items-center gap-1 transition-colors">
                <i class="fa-solid fa-check text-[9px]"></i> One number
              </span>
            </div>
          </div>

          <!-- Confirm Password -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Confirm password</label>
            <div class="relative flex items-center">
              <span class="absolute left-3.5 text-slate-400 pointer-events-none">
                <i class="fa-solid fa-lock text-xs"></i>
              </span>
              <input 
                type="password" 
                name="confirmPassword" 
                id="confirmPasswordField" 
                required 
                placeholder="Confirm your password"
                autocomplete="new-password"
                class="w-full bg-white border border-slate-200/90 rounded-2xl pl-10 pr-10 py-2.5 text-xs text-slate-800 placeholder-slate-400 font-medium shadow-sm focus:outline-none focus:border-[#ff4757] focus:ring-2 focus:ring-[#ff4757]/10 transition-all"
              >
              <button 
                type="button" 
                id="toggleConfirmPasswordBtn" 
                class="absolute right-3.5 text-slate-400 hover:text-slate-600 transition-colors"
                tabindex="-1"
              >
                <i id="eyeConfirmIcon" class="fa-regular fa-eye-slash text-xs"></i>
              </button>
            </div>
          </div>

          <!-- Terms Checkbox -->
          <div class="flex items-center gap-2 pt-0.5">
            <input 
              type="checkbox" 
              name="terms" 
              id="terms" 
              required
              class="w-4 h-4 rounded text-[#ff4757] focus:ring-[#ff4757] border-slate-300 accent-[#ff4757] cursor-pointer"
            >
            <label for="terms" class="text-[11px] font-medium text-slate-600 cursor-pointer select-none">
              I agree to the <a href="#" class="text-[#ff4757] font-semibold hover:underline">Terms &amp; Conditions</a> and <a href="#" class="text-[#ff4757] font-semibold hover:underline">Privacy Policy</a>.
            </label>
          </div>

          <!-- Main CTA Button -->
          <button 
            type="submit" 
            class="w-full mt-2 py-3 rounded-full text-xs font-bold text-white bg-gradient-to-r from-[#ff4757] via-[#ff5252] to-[#ff6b81] hover:brightness-105 active:scale-[0.99] shadow-lg shadow-[#ff4757]/30 transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>Create account</span>
            <i class="fa-solid fa-arrow-right text-[11px]"></i>
          </button>

        </form>

        <!-- Or Continue With Divider -->
        <div class="relative my-4 text-center">
          <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-200"></div></div>
          <span class="relative bg-[#f8fafc] px-3 text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Or continue with</span>
        </div>

        <!-- Social Buttons -->
        <div class="grid grid-cols-2 gap-3">
          <button type="button" class="flex items-center justify-center gap-2 py-2 px-3 rounded-2xl bg-white hover:bg-slate-50 border border-slate-200 shadow-sm text-xs font-semibold text-slate-700 transition-all active:scale-95">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span class="truncate">Continue with Google</span>
          </button>

          <button type="button" class="flex items-center justify-center gap-2 py-2 px-3 rounded-2xl bg-white hover:bg-slate-50 border border-slate-200 shadow-sm text-xs font-semibold text-slate-700 transition-all active:scale-95">
            <i class="fa-brands fa-apple text-sm text-slate-900"></i>
            <span class="truncate">Continue with Apple</span>
          </button>
        </div>

        <!-- Already have an account link -->
        <p class="text-center text-xs text-slate-500 mt-5">
          Already have an account? 
          <a href="/login" class="font-bold text-[#ff4757] hover:underline ml-1">Log in</a>
        </p>

      </div>

      <div class="h-1"></div>

    </div>

  </div>

  <!-- Interactive JavaScript: Password Validation & Show/Hide Toggles -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // 1. Password Visibility Toggle
      const togglePass = (btnId, inputId, iconId) => {
        const btn = document.getElementById(btnId);
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (btn && input && icon) {
          btn.addEventListener("click", () => {
            if (input.type === "password") {
              input.type = "text";
              icon.classList.remove("fa-eye-slash");
              icon.classList.add("fa-eye");
            } else {
              input.type = "password";
              icon.classList.remove("fa-eye");
              icon.classList.add("fa-eye-slash");
            }
          });
        }
      };

      togglePass("togglePasswordBtn", "passwordField", "eyeIcon");
      togglePass("toggleConfirmPasswordBtn", "confirmPasswordField", "eyeConfirmIcon");

      // 2. Realtime Password Requirements Checker
      const passInput = document.getElementById("passwordField");
      const chkLength = document.getElementById("chkLength");
      const chkUpper = document.getElementById("chkUpper");
      const chkNumber = document.getElementById("chkNumber");

      if (passInput) {
        passInput.addEventListener("input", () => {
          const val = passInput.value;

          // Length >= 8
          if (val.length >= 8) {
            chkLength.className = "flex items-center gap-1 text-emerald-500 font-semibold";
          } else {
            chkLength.className = "flex items-center gap-1 text-slate-400 font-normal";
          }

          // At least one uppercase
          if (/[A-Z]/.test(val)) {
            chkUpper.className = "flex items-center gap-1 text-emerald-500 font-semibold";
          } else {
            chkUpper.className = "flex items-center gap-1 text-slate-400 font-normal";
          }

          // At least one number
          if (/[0-9]/.test(val)) {
            chkNumber.className = "flex items-center gap-1 text-emerald-500 font-semibold";
          } else {
            chkNumber.className = "flex items-center gap-1 text-slate-400 font-normal";
          }
        });
      }

      // 3. Username Auto-fill (Sync Email to hidden Username field for Passport)
      const emailInput = document.getElementById("signupEmail");
      const usernameInput = document.getElementById("passportUsername");
      const form = document.getElementById("signupForm");

      if (form && emailInput && usernameInput) {
        form.addEventListener("submit", (e) => {
          usernameInput.value = emailInput.value.trim();
        });
      }
    });
  </script>
</body>
</html>
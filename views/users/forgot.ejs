<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot your password? | WonderLust</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@1,600&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            serif: ['"Playfair Display"', 'serif'],
          }
        }
      }
    }
  </script>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
  <style>
    .glass-panel-dark {
      background: rgba(15, 23, 42, 0.45);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
  </style>
</head>
<body class="bg-[#d5dbe4] text-slate-800 antialiased font-sans min-h-screen flex items-center justify-center p-3 sm:p-6 lg:p-8">

  <!-- Main Split Layout Container -->
  <div class="relative w-full max-w-[1360px] min-h-[740px] lg:h-[840px] bg-[#eef1f6] rounded-[2.5rem] shadow-[0_25px_70px_rgba(0,0,0,0.18)] overflow-hidden flex flex-col lg:flex-row">
    
    <!-- ========================================== -->
    <!-- LEFT PANEL: HERO VISUAL & BRAND STORY      -->
    <!-- ========================================== -->
    <div class="relative w-full lg:w-[52%] min-h-[480px] lg:min-h-full p-8 sm:p-12 lg:p-14 flex flex-col justify-between text-white overflow-hidden">
      
      <!-- Background Santorini Sunset Pool Villa Image -->
      <img 
        src="https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?auto=format&fit=crop&w=2000&q=85" 
        alt="Santorini Sunset Pool Villa" 
        class="absolute inset-0 w-full h-full object-cover object-center z-0"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-black/40 z-10"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-black/50 via-transparent to-transparent z-10"></div>

      <!-- Top Brand Logo -->
      <div class="relative z-20 flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-full border-2 border-[#ff4757] flex items-center justify-center relative p-1 bg-white/10 backdrop-blur-sm">
          <svg viewBox="0 0 24 24" fill="none" class="w-full h-full text-[#ff4757]">
            <circle cx="12" cy="12" r="9" stroke="#ff4757" stroke-width="1.8" />
            <polygon points="12,3 14.5,9.5 21,12 14.5,14.5 12,21 9.5,14.5 3,12 9.5,9.5" fill="#ff4757" />
            <circle cx="18" cy="18" r="2.2" fill="#ffffff" />
          </svg>
        </div>
        <span class="text-2xl font-bold tracking-tight text-white font-sans drop-shadow-sm">
          Wonder<span class="text-[#ff4757]">Lust</span>
        </span>
      </div>

      <!-- Mid Hero Copy (Matching Reference Image) -->
      <div class="relative z-20 my-auto py-8 max-w-lg">
        <span class="block text-[11px] font-bold uppercase tracking-[0.3em] text-white/90 mb-3 drop-shadow">
          EXPLORE &nbsp;·&nbsp; STAY &nbsp;·&nbsp; EXPERIENCE
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-[1.08] text-white drop-shadow-md">
          Never lose<br>
          <span class="bg-gradient-to-r from-[#ff4757] via-[#ff6b81] to-[#ff7f50] bg-clip-text text-transparent">your next<br>adventure.</span>
        </h1>
        <p class="text-xs sm:text-sm text-white/90 mt-5 font-normal leading-relaxed max-w-md drop-shadow">
          Reset your password and get back to discovering extraordinary stays and unforgettable experiences.
        </p>
      </div>

      <!-- Bottom Glass Stats Strip & Testimonial -->
      <div class="relative z-20 space-y-4">
        
        <!-- 3 Feature Badges: Secure, Quick Recovery, Easy & Simple -->
        <div class="glass-panel-dark rounded-2xl border border-white/20 px-5 py-3.5 flex items-center justify-between text-white/95">
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-shield-halved text-[#ff6b81] text-xs"></i>
            <div>
              <span class="block text-xs font-extrabold leading-none">Secure</span>
              <span class="text-[10px] text-white/70">Your data is safe with us</span>
            </div>
          </div>
          <div class="h-6 w-[1px] bg-white/20"></div>
          <div class="flex items-center gap-2.5">
            <i class="fa-regular fa-envelope text-[#ff6b81] text-xs"></i>
            <div>
              <span class="block text-xs font-extrabold leading-none">Quick Recovery</span>
              <span class="text-[10px] text-white/70">Get reset link in your email</span>
            </div>
          </div>
          <div class="h-6 w-[1px] bg-white/20"></div>
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-lock text-[#ff6b81] text-xs"></i>
            <div>
              <span class="block text-xs font-extrabold leading-none">Easy &amp; Simple</span>
              <span class="text-[10px] text-white/70">Back to your journey in minutes</span>
            </div>
          </div>
        </div>

        <!-- User Testimonial: Rahul K. -->
        <div class="glass-panel-dark rounded-2xl border border-white/20 p-4 flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="flex -space-x-2 overflow-hidden shrink-0">
              <img class="inline-block h-8 w-8 rounded-full ring-2 ring-white/50 object-cover" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&q=80" alt="Rahul">
              <img class="inline-block h-8 w-8 rounded-full ring-2 ring-white/50 object-cover" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80" alt="Sarah">
              <img class="inline-block h-8 w-8 rounded-full ring-2 ring-white/50 object-cover" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=120&q=80" alt="Priya">
            </div>
            <div>
              <p class="text-xs text-white/95 font-medium leading-tight">"WonderLust always brings me back to the most amazing places!"</p>
              <div class="flex items-center gap-1.5 mt-1">
                <span class="text-[10px] text-white/70">– Rahul K.</span>
                <div class="flex text-[9px] text-amber-400">
                  <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                </div>
              </div>
            </div>
          </div>

          <!-- Carousel Controls -->
          <div class="flex items-center gap-2 shrink-0">
            <div class="flex items-center gap-1">
              <span class="w-5 h-1 rounded-full bg-white"></span>
              <span class="w-2 h-1 rounded-full bg-white/40"></span>
              <span class="w-2 h-1 rounded-full bg-white/40"></span>
            </div>
            <button type="button" class="w-6 h-6 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white text-[10px] transition-colors"><i class="fa-solid fa-chevron-left"></i></button>
            <button type="button" class="w-6 h-6 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white text-[10px] transition-colors"><i class="fa-solid fa-chevron-right"></i></button>
          </div>

        </div>

      </div>

    </div>

    <!-- ========================================== -->
    <!-- RIGHT PANEL: RESET PASSWORD FORM          -->
    <!-- ========================================== -->
    <div class="relative w-full lg:w-[48%] min-h-full p-8 sm:p-12 lg:p-14 flex flex-col justify-between bg-gradient-to-br from-[#f8fafc]/90 via-[#f1f5f9]/70 to-[#e2e8f0]/80">
      
      <!-- Decorative Floating Travel Polaroid Cards (Right Edge) -->
      <div class="absolute -right-6 top-8 w-36 h-48 bg-white p-2.5 rounded-2xl shadow-xl transform rotate-6 hidden sm:block pointer-events-none opacity-80 border border-slate-200/60 z-0">
        <div class="w-full h-28 bg-rose-50 rounded-xl flex items-center justify-center text-rose-300 text-3xl font-serif">✳</div>
        <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mt-3 text-center">EXPLORE<br>DREAM<br>DISCOVER</p>
      </div>
      <div class="absolute -right-4 bottom-14 w-40 bg-white p-3 rounded-2xl shadow-2xl transform -rotate-3 hidden sm:block pointer-events-none opacity-90 border border-slate-200/60 z-0">
        <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=400&q=80" alt="Beach preview" class="w-full h-24 object-cover rounded-xl mb-2">
        <p class="text-[10px] font-bold text-slate-700 leading-tight">Good Places<br><span class="text-slate-400 font-normal">Good People</span></p>
        <span class="text-[9px] text-[#ff4757] block mt-1">❤</span>
      </div>

      <!-- Top Back To Home Button -->
      <div class="flex justify-end relative z-20">
        <a href="/" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/90 hover:bg-white text-slate-700 hover:text-slate-900 border border-slate-200 shadow-sm text-xs font-semibold transition-all active:scale-95 text-decoration-none">
          <i class="fa-solid fa-house text-slate-400 text-[11px]"></i>
          <span>Back to Home</span>
        </a>
      </div>

      <!-- Center Reset Form Box -->
      <div class="relative z-20 my-auto py-4 max-w-sm w-full mx-auto text-center sm:text-left">
        
        <!-- Illustrated Lock Icon with Dotted Travel Flight Path -->
        <div class="relative w-full flex items-center justify-center mb-5">
          <svg class="absolute w-44 h-16 pointer-events-none -top-1" viewBox="0 0 180 60" fill="none">
            <path d="M 20 40 Q 90 -10 160 25" stroke="#f43f5e" stroke-width="1.6" stroke-dasharray="4 4" stroke-opacity="0.35"/>
            <!-- Tiny Airplane icon at the end of flight path -->
            <path d="M 160 22 L 168 25 L 161 31 L 162 26 Z" fill="#ff4757" opacity="0.45"/>
          </svg>
          <div class="relative w-16 h-16 rounded-2xl bg-rose-50 border border-rose-100 flex items-center justify-center text-2xl text-[#ff4757] shadow-sm">
            <i class="fa-solid fa-lock"></i>
          </div>
        </div>

        <!-- Heading -->
        <div class="text-center mb-6">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Forgot your password?
          </h2>
          <p class="text-xs text-slate-500 mt-1.5 font-normal leading-relaxed max-w-xs mx-auto">
            No worries! Enter your email address and we'll send you a link to reset your password.
          </p>
        </div>

        <!-- Flash Messages -->
        <% if(typeof error !== 'undefined' && error && error.length > 0) { %>
          <div class="mb-4 p-3 rounded-2xl bg-rose-50 border border-rose-200 text-rose-600 text-xs font-semibold flex items-center gap-2 text-left">
            <i class="fa-solid fa-circle-exclamation text-sm"></i>
            <span><%= error %></span>
          </div>
        <% } %>
        <% if(typeof success !== 'undefined' && success && success.length > 0) { %>
          <div class="mb-4 p-3 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-600 text-xs font-semibold flex items-center gap-2 text-left">
            <i class="fa-solid fa-circle-check text-sm"></i>
            <span><%= success %></span>
          </div>
        <% } %>

        <!-- Form -->
        <form action="/forgot-password" method="POST" class="space-y-4 text-left">
          
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Email address</label>
            <div class="relative flex items-center">
              <span class="absolute left-3.5 text-slate-400 pointer-events-none">
                <i class="fa-regular fa-envelope text-xs"></i>
              </span>
              <input 
                type="email" 
                name="email" 
                required 
                placeholder="you@example.com"
                autocomplete="email"
                class="w-full bg-white border border-slate-200/90 rounded-2xl pl-10 pr-4 py-3 text-xs text-slate-800 placeholder-slate-400 font-medium shadow-sm focus:outline-none focus:border-[#ff4757] focus:ring-2 focus:ring-[#ff4757]/10 transition-all"
              >
            </div>
          </div>

          <!-- Send Reset Link Button -->
          <button 
            type="submit" 
            class="w-full mt-2 py-3.5 rounded-full text-xs font-bold text-white bg-gradient-to-r from-[#ff4757] via-[#ff5252] to-[#ff6b81] hover:brightness-105 active:scale-[0.99] shadow-lg shadow-[#ff4757]/30 transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>Send reset link</span>
            <i class="fa-solid fa-arrow-right text-[11px]"></i>
          </button>

        </form>

        <!-- OR Divider -->
        <div class="relative my-5 text-center">
          <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-200"></div></div>
          <span class="relative bg-[#f8fafc] px-3 text-[10px] font-bold text-slate-400 uppercase tracking-widest">OR</span>
        </div>

        <!-- Send via SMS Button -->
        <button 
          type="button" 
          onclick="alert('SMS recovery mode is enabled for verified phone numbers.')"
          class="w-full py-3 px-4 rounded-2xl bg-white hover:bg-slate-50 border border-slate-200 shadow-sm text-xs font-semibold text-slate-700 transition-all active:scale-95 flex items-center justify-center gap-2"
        >
          <i class="fa-solid fa-mobile-screen-button text-xs text-slate-500"></i>
          <span>Send via SMS instead</span>
        </button>

        <!-- Back to Login Link -->
        <div class="text-center mt-6">
          <a href="/login" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#ff4757] hover:underline">
            <i class="fa-solid fa-arrow-left text-[10px]"></i>
            <span>Back to Login</span>
          </a>
        </div>

      </div>

      <div class="h-2"></div>

    </div>

  </div>

</body>
</html>
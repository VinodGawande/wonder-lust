<% layout("/layouts/boilerplate") %>

<div class="relative w-full antialiased font-sans text-slate-800 bg-[#f8f9fb] min-h-screen pb-24">

  <!-- ========================================== -->
  <!-- 1. TOP HERO BANNER: Sunset Panorama        -->
  <!-- ========================================== -->
  <div class="relative w-full h-56 sm:h-64 overflow-hidden">
    <img 
      src="https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?auto=format&fit=crop&w=2000&q=85" 
      alt="Santorini Coastal Sunset Panorama" 
      class="w-full h-full object-cover object-center filter brightness-[0.92]"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-transparent to-[#f8f9fb]"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex flex-col justify-end pb-8 relative z-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Saved</h1>
      <p class="text-xs sm:text-sm text-slate-600 font-medium mt-1">
        Your favorite stays, experiences and destinations — all in one place.
      </p>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 2. MAIN CONTAINER & TOP PILL TABS STRIP    -->
  <!-- ========================================== -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-2 space-y-10">
    
    <!-- Top Horizontal Filter Capsule Bar -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] p-2 flex items-center gap-2 overflow-x-auto no-scrollbar">
      <a href="#savedStaysSection" class="flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-[#ff4757] bg-rose-50/70 border border-rose-100 transition-all text-decoration-none shrink-0">
        <i class="fa-solid fa-house text-[11px]"></i>
        <span>Saved Stays (<span id="topStaysCount"><%= stays.length %></span>)</span>
      </a>

      <a href="#savedExpSection" class="flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-all text-decoration-none shrink-0">
        <i class="fa-solid fa-compass text-[11px] text-slate-400"></i>
        <span>Saved Experiences (<span id="topExpCount"><%= experiences.length %></span>)</span>
      </a>

      <a href="#savedDestSection" class="flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-all text-decoration-none shrink-0">
        <i class="fa-solid fa-location-dot text-[11px] text-slate-400"></i>
        <span>Saved Destinations (<span id="topDestCount"><%= destinations.length %></span>)</span>
      </a>
    </div>

    <!-- ========================================== -->
    <!-- SECTION 1: SAVED STAYS (4-COL GRID)        -->
    <!-- ========================================== -->
    <section id="savedStaysSection" class="space-y-4">
      
      <!-- Section Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-rose-50 border border-rose-100 flex items-center justify-center text-[#ff4757] text-xs">
            <i class="fa-solid fa-house"></i>
          </div>
          <div>
            <h2 class="text-base font-extrabold text-slate-900 leading-tight">
              Saved Stays (<span id="staysHeadingCount"><%= stays.length %></span>)
            </h2>
            <p class="text-[11px] text-slate-400">Stays you've saved for your next trip.</p>
          </div>
        </div>

        <div class="flex items-center gap-2 self-end sm:self-auto">
          <button type="button" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-slate-200 bg-white text-[11px] font-semibold text-slate-700 hover:bg-slate-50 shadow-sm cursor-pointer">
            <span>Recently Saved</span>
            <i class="fa-solid fa-chevron-down text-[8px] text-slate-400"></i>
          </button>
          <button type="button" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-slate-200 bg-white text-[11px] font-semibold text-slate-700 hover:bg-slate-50 shadow-sm cursor-pointer">
            <i class="fa-solid fa-sliders text-[10px] text-slate-500"></i>
            <span>Filter</span>
          </button>
          <a href="/listings" class="text-[11px] font-bold text-[#ff4757] hover:underline ml-1">View All (<%= stays.length %>) →</a>
        </div>
      </div>

      <!-- 4 Cards Grid Loop -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <% for(let stay of stays) { %>
          <% 
            const stayImg = (stay.image && (typeof stay.image === 'string' ? stay.image : stay.image.url)) || 'https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?auto=format&fit=crop&w=600&q=80';
            const priceVal = (stay.price || 12500).toLocaleString("en-IN");
          %>
          <div class="stay-card group bg-white rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] overflow-hidden transition-all hover:shadow-md" data-id="<%= stay._id %>">
            <div class="relative w-full aspect-[4/3] bg-slate-100 overflow-hidden">
              <a href="/listings/<%= stay._id %>" class="block w-full h-full">
                <img src="<%= stayImg %>" alt="<%= stay.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
              </a>
              <button 
                type="button" 
                onclick="handleLiveUnsave(this, '<%= stay._id %>', 'stay')" 
                class="absolute top-2.5 right-2.5 w-7 h-7 rounded-full bg-white text-[#ff4757] flex items-center justify-center shadow-md text-xs hover:scale-110 active:scale-95 transition-all cursor-pointer"
                title="Remove from saved"
              >
                <i class="fa-solid fa-heart"></i>
              </button>
            </div>
            <div class="p-3.5 space-y-1">
              <div class="flex items-start justify-between">
                <a href="/listings/<%= stay._id %>" class="text-xs font-bold text-slate-900 truncate hover:text-[#ff4757] text-decoration-none">
                  <%= stay.title %>
                </a>
                <button class="text-slate-400 hover:text-slate-700 text-xs px-1 cursor-pointer">⋮</button>
              </div>
              <p class="text-[10px] text-slate-500 flex items-center gap-1">
                <i class="fa-solid fa-location-dot text-[9px] text-slate-400"></i><%= stay.location %>
              </p>
              <div class="flex items-center gap-1 text-[10px] text-slate-500">
                <span class="text-amber-500 font-bold">★ <%= stay.rating || 4.8 %></span>
                <span>(<%= stay.reviewsCount || 320 %> reviews)</span>
              </div>
              <div class="pt-1 text-xs">
                <span class="font-extrabold text-slate-900">₹<%= priceVal %></span>
                <span class="text-[10px] text-slate-400 font-normal">/ night</span>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- SECTION 2: SAVED EXPERIENCES (3-COL GRID)  -->
    <!-- ========================================== -->
    <section id="savedExpSection" class="space-y-4 pt-4">
      
      <!-- Section Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-rose-50 border border-rose-100 flex items-center justify-center text-[#ff4757] text-xs">
            <i class="fa-solid fa-compass"></i>
          </div>
          <div>
            <h2 class="text-base font-extrabold text-slate-900 leading-tight">
              Saved Experiences (<span id="expHeadingCount"><%= experiences.length %></span>)
            </h2>
            <p class="text-[11px] text-slate-400">Experiences you've saved to try.</p>
          </div>
        </div>

        <div class="flex items-center gap-2 self-end sm:self-auto">
          <button type="button" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-slate-200 bg-white text-[11px] font-semibold text-slate-700 hover:bg-slate-50 shadow-sm cursor-pointer">
            <span>Recently Saved</span>
            <i class="fa-solid fa-chevron-down text-[8px] text-slate-400"></i>
          </button>
          <button type="button" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-slate-200 bg-white text-[11px] font-semibold text-slate-700 hover:bg-slate-50 shadow-sm cursor-pointer">
            <i class="fa-solid fa-sliders text-[10px] text-slate-500"></i>
            <span>Filter</span>
          </button>
          <a href="/experiences" class="text-[11px] font-bold text-[#ff4757] hover:underline ml-1">View All (<%= experiences.length %>) →</a>
        </div>
      </div>

      <!-- 3 Cards Grid Loop -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <% for(let exp of experiences) { %>
          <% 
            const expImg = (exp.image && (typeof exp.image === 'string' ? exp.image : exp.image.url)) || 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=600&q=80';
            const expPrice = (exp.price || 8500).toLocaleString("en-IN");
          %>
          <div class="exp-card group bg-white rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] overflow-hidden transition-all hover:shadow-md" data-id="<%= exp._id %>">
            <div class="relative w-full aspect-[16/10] bg-slate-100 overflow-hidden">
              <a href="/experiences" class="block w-full h-full">
                <img src="<%= expImg %>" alt="<%= exp.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
              </a>
              <button 
                type="button" 
                onclick="handleLiveUnsave(this, '<%= exp._id %>', 'experience')" 
                class="absolute top-2.5 right-2.5 w-7 h-7 rounded-full bg-white text-[#ff4757] flex items-center justify-center shadow-md text-xs hover:scale-110 active:scale-95 transition-all cursor-pointer"
                title="Remove from saved"
              >
                <i class="fa-solid fa-heart"></i>
              </button>
            </div>
            <div class="p-4 space-y-1.5">
              <div class="flex items-start justify-between">
                <h3 class="text-xs font-bold text-slate-900 truncate"><%= exp.title %></h3>
                <button class="text-slate-400 hover:text-slate-700 text-xs px-1 cursor-pointer">⋮</button>
              </div>
              <p class="text-[10px] text-slate-500 flex items-center gap-1">
                <i class="fa-solid fa-location-dot text-[9px] text-slate-400"></i><%= exp.location %>
              </p>
              <div class="flex items-center justify-between text-[10px] text-slate-500 pt-1">
                <div class="flex items-center gap-1">
                  <span class="text-amber-500 font-bold">★ <%= exp.rating || 4.7 %></span>
                  <span>(<%= exp.reviewsCount || 256 %> reviews)</span>
                </div>
                <div class="flex items-center gap-2 text-[10px] text-slate-500">
                  <span><i class="fa-regular fa-clock mr-1 text-[9px]"></i><%= exp.duration || "2–3 hours" %></span>
                  <span>•</span>
                  <span><i class="fa-solid fa-users mr-1 text-[9px]"></i><%= exp.tourType || "Group tour" %></span>
                </div>
              </div>
              <div class="pt-2 text-xs">
                <span class="font-extrabold text-slate-900">₹<%= expPrice %></span>
                <span class="text-[10px] text-slate-400 font-normal">/ person</span>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- SECTION 3: SAVED DESTINATIONS (2-COL SPLIT)-->
    <!-- ========================================== -->
    <section id="savedDestSection" class="space-y-4 pt-4">
      
      <!-- Section Header -->
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-rose-50 border border-rose-100 flex items-center justify-center text-[#ff4757] text-xs">
            <i class="fa-solid fa-location-dot"></i>
          </div>
          <div>
            <h2 class="text-base font-extrabold text-slate-900 leading-tight">
              Saved Destinations (<span id="destHeadingCount"><%= destinations.length %></span>)
            </h2>
            <p class="text-[11px] text-slate-400">Destinations you've saved to explore.</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button type="button" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-slate-200 bg-white text-[11px] font-semibold text-slate-700 hover:bg-slate-50 shadow-sm cursor-pointer">
            <span>Recently Saved</span>
            <i class="fa-solid fa-chevron-down text-[8px] text-slate-400"></i>
          </button>
          <a href="/destinations" class="text-[11px] font-bold text-[#ff4757] hover:underline ml-1">View All (<%= destinations.length %>) →</a>
        </div>
      </div>

      <!-- 2 Cards Horizontal Layout Loop -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <% for(let dest of destinations) { %>
          <% const destImg = (dest.image && (typeof dest.image === 'string' ? dest.image : dest.image.url)) || 'https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?auto=format&fit=crop&w=600&q=80'; %>
          <div class="dest-card group bg-white rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] overflow-hidden flex flex-col sm:flex-row transition-all hover:shadow-md" data-id="<%= dest._id %>">
            <div class="w-full sm:w-2/5 aspect-[4/3] sm:aspect-auto bg-slate-100 overflow-hidden">
              <img src="<%= destImg %>" alt="<%= dest.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
            </div>
            <div class="w-full sm:w-3/5 p-4 sm:p-5 flex flex-col justify-between space-y-3">
              <div>
                <div class="flex items-center justify-between">
                  <h3 class="text-xs font-bold text-slate-900"><%= dest.title %></h3>
                  <div class="flex items-center gap-1">
                    <button type="button" onclick="handleLiveUnsave(this, '<%= dest._id %>', 'destination')" class="w-6 h-6 rounded-full text-[#ff4757] flex items-center justify-center text-xs cursor-pointer">
                      <i class="fa-solid fa-heart"></i>
                    </button>
                    <button class="text-slate-400 hover:text-slate-700 text-xs px-1 cursor-pointer">⋮</button>
                  </div>
                </div>
                <p class="text-[11px] text-slate-500 mt-1 line-clamp-2"><%= dest.description %></p>
              </div>
              <div class="pt-2 flex justify-end">
                <a href="<%= dest.link || '/destinations' %>" class="text-[11px] font-bold text-[#ff4757] hover:underline flex items-center gap-1">
                  <span>View Destination</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </section>

  </div>

</div>

<!-- Real-time AJAX Unsave & Toast Script -->
<script>
  async function handleLiveUnsave(button, itemId, itemType) {
    const icon = button.querySelector("i");
    const card = button.closest(".stay-card") || button.closest(".exp-card") || button.closest(".dest-card");

    // Client optimistic toggle
    const isCurrentlySaved = icon.classList.contains("fa-solid");

    try {
      const res = await fetch("/api/saved/toggle", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ itemId, itemType })
      });

      const data = await res.json();

      if (data.success) {
        if (!data.isSaved) {
          icon.classList.remove("fa-solid", "text-[#ff4757]");
          icon.classList.add("fa-regular", "text-slate-400");
          if (card) card.style.opacity = "0.45";
          showSavedToast("Item removed from your saved collection.");
        } else {
          icon.classList.remove("fa-regular", "text-slate-400");
          icon.classList.add("fa-solid", "text-[#ff4757]");
          if (card) card.style.opacity = "1";
          showSavedToast("Saved back to your collection.");
        }
      }
    } catch (err) {
      console.error(err);
      // Fallback visual feedback
      if (isCurrentlySaved) {
        icon.classList.remove("fa-solid", "text-[#ff4757]");
        icon.classList.add("fa-regular", "text-slate-400");
        if (card) card.style.opacity = "0.45";
        showSavedToast("Item removed from your saved collection.");
      }
    }
  }

  function showSavedToast(message) {
    const existing = document.getElementById("savedDynamicToast");
    if (existing) existing.remove();

    const toast = document.createElement("div");
    toast.id = "savedDynamicToast";
    toast.className = "fixed top-24 left-1/2 transform -translate-x-1/2 z-[100] px-5 py-3 rounded-2xl shadow-xl flex items-center gap-2.5 text-xs font-semibold backdrop-blur-md bg-emerald-600 text-white transition-all duration-300";
    toast.innerHTML = `<i class="fa-solid fa-circle-check text-sm"></i><span>${message}</span>`;

    document.body.appendChild(toast);
    setTimeout(() => {
      toast.style.opacity = "0";
      toast.style.transform = "translate(-50%, -15px)";
      setTimeout(() => toast.remove(), 350);
    }, 3000);
  }
</script>
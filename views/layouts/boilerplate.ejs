<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WonderLust | Explore the World</title>

  <!-- Google Fonts: Plus Jakarta Sans & Playfair Display -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind CSS CDN (Play CDN - Instantly applies all Tailwind classes) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            serif: ['"Playfair Display"', 'serif'],
          }
        }
      }
    }
  </script>

  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

  <!-- Local Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[#f8fafc] font-sans text-slate-800 antialiased selection:bg-[#ff4757]/20 selection:text-[#ff4757] min-h-screen flex flex-col justify-between">

  <!-- Floating Glass Navbar -->
  <%- include("../partials/navbar.ejs") %>

  <!-- Main Body Content Injected Here -->
  <main class="flex-grow">
    <%- body %>
  </main>

  <!-- Global Footer -->
  <%- include("../partials/footer.ejs") %>

  <!-- Bootstrap / Helper Scripts if needed -->
  <script src="/js/script.js"></script>
</body>
</html>
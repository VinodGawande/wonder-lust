<% layout("/layouts/boilerplate") %>

<!-- Light Mode Safe Page Wrapper -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16 antialiased font-sans text-slate-800">

  <!-- 1. BREADCRUMBS -->
  <nav class="flex items-center gap-2 text-[11px] text-slate-400 mb-3">
    <a href="/" class="hover:text-slate-700 text-decoration-none text-slate-400">Home</a>
    <span>›</span>
    <a href="/listings" class="hover:text-slate-700 text-decoration-none text-slate-400">Stays</a>
    <span>›</span>
    <span class="text-slate-400"><%= listing.country || "Worldwide" %></span>
    <span>›</span>
    <span class="text-slate-400"><%= listing.location %></span>
    <span>›</span>
    <span class="text-slate-700 font-semibold truncate"><%= listing.title %></span>
  </nav>

  <!-- 2. HEADER: Title, Badges & Save/Share -->
  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-4">
    <div>
      <div class="flex items-center gap-2.5 flex-wrap">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          <%= listing.title %>
        </h1>
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
          ★ Superhost
        </span>
      </div>

      <div class="flex items-center gap-3 text-xs text-slate-600 mt-2 flex-wrap">
        <div class="flex items-center gap-1 font-semibold text-slate-900">
          <i class="fa-solid fa-star text-amber-500 text-[11px]"></i>
          <span><%= (listing.reviews && listing.reviews.length > 0) ? (4.8).toFixed(1) : "New" %></span>
          <span class="text-slate-400 font-normal">(<%= (listing.reviews && listing.reviews.length) || 320 %> reviews)</span>
        </div>
        <span>•</span>
        <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-rose-600">
          <i class="fa-solid fa-trophy text-[10px]"></i> Guest favorite
        </span>
        <span>•</span>
        <span class="text-slate-600"><i class="fa-solid fa-location-dot text-slate-400 mr-1"></i><%= listing.location %>, <%= listing.country %></span>
        <span>•</span>
        <span class="text-slate-500"><i class="fa-solid fa-mountain-sun text-slate-400 mr-1"></i>Stunning views</span>
      </div>
    </div>

    <!-- Save & Share Buttons -->
    <div class="flex items-center gap-2 text-xs font-semibold">
      <button type="button" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-slate-200 hover:bg-slate-50 text-slate-700 transition-colors">
        <i class="fa-regular fa-heart text-[#ff4757]"></i>
        <span>Save</span>
      </button>
      <button type="button" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-slate-200 hover:bg-slate-50 text-slate-700 transition-colors">
        <i class="fa-solid fa-arrow-up-from-bracket text-slate-600"></i>
        <span>Share</span>
      </button>
    </div>
  </div>

  <!-- 3. PHOTO GALLERY GRID (Large main + 4 Grid + '+photos' Pill) -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-2 rounded-3xl overflow-hidden mb-8 relative max-h-[460px]">
    
    <!-- Main Big Image -->
    <div class="md:col-span-7 relative h-72 md:h-[460px] group overflow-hidden">
      <img 
        src="<%= (listing.image && (typeof listing.image === 'string' ? listing.image : listing.image.url)) || 'https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?auto=format&fit=crop&w=1200&q=85' %>" 
        alt="<%= listing.title %>"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
      <div class="absolute bottom-3 right-3 bg-black/60 text-white text-[11px] font-semibold px-2.5 py-1 rounded-full backdrop-blur-sm">
        1/32
      </div>
    </div>

    <!-- 4 Side Images Grid -->
    <div class="md:col-span-5 grid grid-cols-2 gap-2 h-72 md:h-[460px]">
      <div class="relative overflow-hidden group">
        <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=600&q=80" alt="Room 1" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
      </div>
      <div class="relative overflow-hidden group">
        <img src="https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=600&q=80" alt="Dining View" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
      </div>
      <div class="relative overflow-hidden group">
        <img src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=600&q=80" alt="Poolside" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
      </div>
      <div class="relative overflow-hidden group">
        <img src="https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&w=600&q=80" alt="Terrace" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
        <!-- +29 Photos Overlay -->
        <button type="button" class="absolute inset-0 bg-black/40 hover:bg-black/50 text-white font-bold text-xs flex items-center justify-center gap-1.5 transition-colors">
          <i class="fa-solid fa-grip text-sm"></i>
          <span>+29 photos</span>
        </button>
      </div>
    </div>

  </div>

  <!-- 4. MAIN DETAILS & STICKY BOOKING CARD CONTAINER -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
    
    <!-- LEFT CONTENT COLUMN (Col 7) -->
    <div class="lg:col-span-7 space-y-8">
      
      <!-- Key Specs Horizontal Badges Strip -->
      <div class="bg-white rounded-2xl border border-slate-200/80 p-4 shadow-sm grid grid-cols-3 sm:grid-cols-6 gap-3 text-center">
        <div class="space-y-1">
          <i class="fa-solid fa-house text-[#ff4757] text-base"></i>
          <h6 class="text-[11px] font-bold text-slate-800 leading-tight">Entire villa</h6>
          <span class="text-[9px] text-slate-400 block leading-tight">You'll have the place to yourself</span>
        </div>
        <div class="space-y-1">
          <i class="fa-solid fa-user-group text-slate-700 text-base"></i>
          <h6 class="text-[11px] font-bold text-slate-800 leading-tight">4 guests</h6>
          <span class="text-[9px] text-slate-400 block leading-tight">2 bedrooms • 2 beds</span>
        </div>
        <div class="space-y-1">
          <i class="fa-solid fa-bath text-slate-700 text-base"></i>
          <h6 class="text-[11px] font-bold text-slate-800 leading-tight">2 bathrooms</h6>
          <span class="text-[9px] text-slate-400 block leading-tight">Hot water available</span>
        </div>
        <div class="space-y-1">
          <i class="fa-solid fa-water text-cyan-600 text-base"></i>
          <h6 class="text-[11px] font-bold text-slate-800 leading-tight">Ocean view</h6>
          <span class="text-[9px] text-slate-400 block leading-tight">Breathtaking views</span>
        </div>
        <div class="space-y-1">
          <i class="fa-solid fa-person-swimming text-[#ff4757] text-base"></i>
          <h6 class="text-[11px] font-bold text-slate-800 leading-tight">Private pool</h6>
          <span class="text-[9px] text-slate-400 block leading-tight">Infinity pool</span>
        </div>
        <div class="space-y-1">
          <i class="fa-solid fa-wifi text-emerald-600 text-base"></i>
          <h6 class="text-[11px] font-bold text-slate-800 leading-tight">Free WiFi</h6>
          <span class="text-[9px] text-slate-400 block leading-tight">High-speed internet</span>
        </div>
      </div>

      <!-- About this place -->
      <div class="space-y-3 pt-2">
        <h3 class="text-lg font-bold text-slate-900">About this place</h3>
        <p class="text-xs text-slate-600 leading-relaxed font-normal">
          <%= listing.description || "A stunning cliffside villa with panoramic views of the Aegean Sea. Enjoy breathtaking sunsets, a private infinity pool, and modern amenities in the heart of the village. Perfect for couples, families, or small groups looking for a peaceful and luxurious stay." %>
        </p>
        <button type="button" class="text-xs font-bold text-[#ff4757] hover:underline flex items-center gap-1">
          <span>Show more</span>
          <i class="fa-solid fa-angle-down text-[10px]"></i>
        </button>

        <!-- Feature pills -->
        <div class="flex items-center gap-2 flex-wrap pt-2">
          <span class="px-3 py-1.5 rounded-full bg-slate-100 text-[10px] font-semibold text-slate-700 flex items-center gap-1.5">
            <i class="fa-regular fa-image text-slate-500"></i> Great for scenic views
          </span>
          <span class="px-3 py-1.5 rounded-full bg-slate-100 text-[10px] font-semibold text-slate-700 flex items-center gap-1.5">
            <i class="fa-solid fa-key text-slate-500"></i> Self check-in
          </span>
          <span class="px-3 py-1.5 rounded-full bg-slate-100 text-[10px] font-semibold text-slate-700 flex items-center gap-1.5">
            <i class="fa-regular fa-calendar-check text-slate-500"></i> Free cancellation
          </span>
          <span class="px-3 py-1.5 rounded-full bg-slate-100 text-[10px] font-semibold text-slate-700 flex items-center gap-1.5">
            <i class="fa-solid fa-percent text-slate-500"></i> 7+ days discount
          </span>
        </div>
      </div>

      <!-- Where you'll sleep -->
      <div class="pt-4 border-t border-slate-200/70 space-y-3">
        <h3 class="text-lg font-bold text-slate-900">Where you'll sleep</h3>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Bedroom 1 -->
          <div class="bg-white rounded-2xl border border-slate-200/80 p-3.5 shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-3">
              <img src="https://images.unsplash.com/photo-1595526114035-0d45ed16cfbf?auto=format&fit=crop&w=200&q=80" alt="Bedroom 1" class="w-14 h-14 rounded-xl object-cover">
              <div>
                <h6 class="text-xs font-bold text-slate-900">Bedroom 1</h6>
                <span class="text-[11px] text-slate-600 block"><i class="fa-solid fa-bed text-slate-400 mr-1"></i>1 queen bed</span>
                <span class="text-[10px] text-slate-400 block mt-0.5">Ocean view • Balcony</span>
              </div>
            </div>
            <i class="fa-solid fa-chevron-right text-xs text-slate-300"></i>
          </div>

          <!-- Bedroom 2 -->
          <div class="bg-white rounded-2xl border border-slate-200/80 p-3.5 shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-3">
              <img src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=200&q=80" alt="Bedroom 2" class="w-14 h-14 rounded-xl object-cover">
              <div>
                <h6 class="text-xs font-bold text-slate-900">Bedroom 2</h6>
                <span class="text-[11px] text-slate-600 block"><i class="fa-solid fa-bed text-slate-400 mr-1"></i>1 queen bed</span>
                <span class="text-[10px] text-slate-400 block mt-0.5">Sea view • Workspace</span>
              </div>
            </div>
            <i class="fa-solid fa-chevron-right text-xs text-slate-300"></i>
          </div>
        </div>
      </div>

      <!-- What this place offers -->
      <div class="pt-4 border-t border-slate-200/70 space-y-4">
        <h3 class="text-lg font-bold text-slate-900">What this place offers</h3>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-y-3.5 gap-x-6 text-xs text-slate-700">
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-person-swimming text-slate-600 w-4 text-center"></i>
            <span>Private pool</span>
          </div>
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-utensils text-slate-600 w-4 text-center"></i>
            <span>Kitchen</span>
          </div>
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-soap text-slate-600 w-4 text-center"></i>
            <span>Washer</span>
          </div>
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-water text-slate-600 w-4 text-center"></i>
            <span>Ocean view</span>
          </div>
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-laptop text-slate-600 w-4 text-center"></i>
            <span>Dedicated workspace</span>
          </div>
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-wind text-slate-600 w-4 text-center"></i>
            <span>Hair dryer</span>
          </div>
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-square-parking text-slate-600 w-4 text-center"></i>
            <span>Free parking</span>
          </div>
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-wifi text-slate-600 w-4 text-center"></i>
            <span>WiFi</span>
          </div>
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-door-open text-slate-600 w-4 text-center"></i>
            <span>Self check-in</span>
          </div>
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-snowflake text-slate-600 w-4 text-center"></i>
            <span>Air conditioning</span>
          </div>
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-tv text-slate-600 w-4 text-center"></i>
            <span>TV</span>
          </div>
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-champagne-glasses text-slate-600 w-4 text-center"></i>
            <span>Outdoor dining area</span>
          </div>
        </div>

        <button type="button" class="px-5 py-2 rounded-full border border-slate-800 text-xs font-bold hover:bg-slate-900 hover:text-white transition-all">
          Show all 28 amenities
        </button>
      </div>

      <!-- Things to know -->
      <div class="pt-4 border-t border-slate-200/70 space-y-3">
        <h3 class="text-lg font-bold text-slate-900">Things to know</h3>
        
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
          <div class="space-y-1">
            <i class="fa-regular fa-clock text-slate-400"></i>
            <h6 class="font-bold text-slate-800 text-[11px]">Check-in</h6>
            <span class="text-[10px] text-slate-500">3:00 PM – 12:00 AM</span>
          </div>
          <div class="space-y-1">
            <i class="fa-regular fa-calendar-xmark text-slate-400"></i>
            <h6 class="font-bold text-slate-800 text-[11px]">Check-out</h6>
            <span class="text-[10px] text-slate-500">Before 11:00 AM</span>
          </div>
          <div class="space-y-1">
            <i class="fa-solid fa-lock text-slate-400"></i>
            <h6 class="font-bold text-slate-800 text-[11px]">Self check-in</h6>
            <span class="text-[10px] text-slate-500">Lockbox</span>
          </div>
          <div class="space-y-1">
            <i class="fa-regular fa-circle-question text-slate-400"></i>
            <h6 class="font-bold text-slate-800 text-[11px]">Cancellation policy</h6>
            <span class="text-[10px] text-slate-500">Free cancellation for 48 hours</span>
          </div>
        </div>
      </div>

    </div>

    <!-- RIGHT STICKY BOOKING SIDEBAR (Col 5) -->
    <div class="lg:col-span-5 space-y-6">
      
      <!-- Sticky Card -->
      <div class="sticky top-24 bg-white rounded-3xl border border-slate-200/90 shadow-[0_12px_40px_rgba(0,0,0,0.08)] p-6 space-y-5">
        
        <!-- Price & Review Badge -->
        <div class="flex items-center justify-between">
          <div>
            <span class="text-2xl font-extrabold text-slate-900">₹<%= listing.price ? listing.price.toLocaleString("en-IN") : "12,500" %></span>
            <span class="text-xs text-slate-500 font-normal">/ night</span>
          </div>
          <div class="text-xs font-semibold text-slate-800 flex items-center gap-1">
            <i class="fa-solid fa-star text-amber-500 text-[11px]"></i>
            <span>4.8</span>
            <span class="text-slate-400 font-normal">(320 reviews)</span>
          </div>
        </div>

        <!-- Date & Guest Picker Widget -->
        <div class="border border-slate-300 rounded-2xl overflow-hidden divide-y divide-slate-200 text-xs">
          <div class="grid grid-cols-2 divide-x divide-slate-200 bg-slate-50/50">
            <div class="p-2.5">
              <label class="block text-[9px] uppercase font-bold text-slate-400 tracking-wider">Check-in</label>
              <div class="flex items-center gap-1.5 font-bold text-slate-800 mt-0.5">
                <i class="fa-regular fa-calendar text-slate-400 text-[11px]"></i>
                <input type="text" id="checkinDate" value="Wed, 12 Mar" class="w-full bg-transparent border-0 p-0 text-xs font-bold focus:outline-none cursor-pointer">
              </div>
            </div>
            <div class="p-2.5">
              <label class="block text-[9px] uppercase font-bold text-slate-400 tracking-wider">Check-out</label>
              <div class="flex items-center gap-1.5 font-bold text-slate-800 mt-0.5">
                <i class="fa-regular fa-calendar text-slate-400 text-[11px]"></i>
                <input type="text" id="checkoutDate" value="Sun, 16 Mar" class="w-full bg-transparent border-0 p-0 text-xs font-bold focus:outline-none cursor-pointer">
              </div>
            </div>
          </div>
          
          <div class="p-2.5 flex items-center justify-between">
            <div>
              <label class="block text-[9px] uppercase font-bold text-slate-400 tracking-wider">Guests</label>
              <span class="font-bold text-slate-800 flex items-center gap-1 mt-0.5">
                <i class="fa-solid fa-user-group text-slate-400 text-[11px]"></i>
                <span id="guestsCount">2 guests</span>
              </span>
            </div>
            <i class="fa-solid fa-chevron-down text-xs text-slate-400"></i>
          </div>
        </div>

        <!-- Reserve CTA Button -->
        <button type="button" id="reserveStayBtn" class="w-full py-3.5 rounded-full text-xs font-extrabold text-white bg-gradient-to-r from-[#ff4757] via-[#ff5252] to-[#ff6b81] hover:brightness-105 active:scale-[0.99] shadow-lg shadow-[#ff4757]/30 transition-all">
          Reserve
        </button>

        <p class="text-[11px] text-center text-slate-400">You won't be charged yet</p>

        <!-- Dynamic Price Details Calculation -->
        <% const basePrice = listing.price || 12500; %>
        <% const nights = 4; %>
        <% const baseTotal = basePrice * nights; %>
        <% const cleanFee = 2000; %>
        <% const serviceFee = 3000; %>
        <% const grandTotal = baseTotal + cleanFee + serviceFee; %>

        <div class="pt-4 border-t border-slate-200/80 space-y-2.5 text-xs text-slate-600">
          <h6 class="font-bold text-slate-800 text-[11px] mb-2">Price details</h6>
          <div class="flex justify-between">
            <span class="underline">₹<%= basePrice.toLocaleString("en-IN") %> × <%= nights %> nights</span>
            <span>₹<%= baseTotal.toLocaleString("en-IN") %></span>
          </div>
          <div class="flex justify-between">
            <span class="underline">Cleaning fee</span>
            <span>₹<%= cleanFee.toLocaleString("en-IN") %></span>
          </div>
          <div class="flex justify-between">
            <span class="underline">Service fee</span>
            <span>₹<%= serviceFee.toLocaleString("en-IN") %></span>
          </div>
          <div class="pt-3 border-t border-slate-200 flex justify-between font-extrabold text-slate-900 text-sm">
            <span>Total</span>
            <span class="text-[#ff4757]">₹<%= grandTotal.toLocaleString("en-IN") %></span>
          </div>
        </div>

      </div>

      <!-- Host Profile Box -->
      <div class="bg-white rounded-2xl border border-slate-200/80 p-4 shadow-sm flex items-center justify-between">
        <div class="flex items-center gap-3">
          <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&q=80" alt="Host" class="w-11 h-11 rounded-full object-cover">
          <div>
            <h6 class="text-xs font-bold text-slate-900">Hosted by <%= (listing.owner && listing.owner.username) ? listing.owner.username : "Nikos" %></h6>
            <span class="text-[11px] text-slate-500">Superhost • 5 years hosting</span>
          </div>
        </div>
        <i class="fa-solid fa-chevron-right text-xs text-slate-400"></i>
      </div>

      <!-- Location Map Snippet -->
      <div class="bg-white rounded-2xl border border-slate-200/80 p-4 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <h6 class="text-xs font-bold text-slate-900">Location</h6>
          <a href="#map" class="text-[11px] font-bold text-[#ff4757] hover:underline flex items-center gap-1">
            <span>Show on map</span>
            <i class="fa-solid fa-arrow-right text-[9px]"></i>
          </a>
        </div>
        
        <!-- Stylized Map Graphic Preview -->
        <div class="relative w-full h-36 rounded-xl overflow-hidden border border-slate-200 bg-sky-100 flex items-center justify-center">
          <img src="https://images.unsplash.com/photo-1524661135-423995f22d0b?auto=format&fit=crop&w=600&q=80" alt="Map Preview" class="w-full h-full object-cover opacity-70">
          <div class="absolute w-8 h-8 rounded-full bg-[#ff4757] text-white flex items-center justify-center shadow-lg animate-bounce">
            <i class="fa-solid fa-location-dot text-sm"></i>
          </div>
        </div>

        <div>
          <span class="text-xs font-bold text-slate-800 block"><%= listing.location %>, <%= listing.country %></span>
          <span class="text-[10px] text-slate-400">Exact location will be shared after booking.</span>
        </div>
      </div>

      <!-- What guests loved (Testimonial snippet cards) -->
      <div class="bg-white rounded-2xl border border-slate-200/80 p-4 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <h6 class="text-xs font-bold text-slate-900">What guests loved</h6>
          <a href="#reviews" class="text-[11px] font-bold text-[#ff4757] hover:underline flex items-center gap-1">
            <span>See all reviews</span>
            <i class="fa-solid fa-arrow-right text-[9px]"></i>
          </a>
        </div>

        <div class="space-y-3">
          
          <!-- Review 1 -->
          <div class="flex items-start gap-3 p-2.5 rounded-xl bg-slate-50 border border-slate-100">
            <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=80&q=80" class="w-12 h-12 rounded-lg object-cover shrink-0" alt="Stay view">
            <div class="space-y-1">
              <p class="text-[10px] text-slate-600 italic">"The view is absolutely magical! The villa was clean, spacious and exactly like the photos."</p>

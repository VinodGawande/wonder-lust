<!-- Popular Destinations (6-Column Grid from Image 1) -->
<section class="w-full my-12">
  <div class="flex items-end justify-between mb-6">
    <div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Popular Destinations</h2>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">Explore the most loved destinations by travelers</p>
    </div>
    <a href="/listings" class="text-xs sm:text-sm font-semibold text-[#ff4757] hover:underline flex items-center gap-1">
      <span>View all</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>
  </div>

  <%
    const destinations = [
      { name: "Bali", country: "Indonesia", stays: "1,200+ stays", img: "https://images.unsplash.com/photo-1537996194471-e657df975ab4?auto=format&fit=crop&w=600&q=80" },
      { name: "Santorini", country: "Greece", stays: "850+ stays", img: "https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?auto=format&fit=crop&w=600&q=80" },
      { name: "Switzerland", country: "Alpine region", stays: "650+ stays", img: "https://images.unsplash.com/photo-1530122037265-a5f1f91d3b99?auto=format&fit=crop&w=600&q=80" },
      { name: "Maldives", country: "Indian Ocean", stays: "420+ stays", img: "https://images.unsplash.com/photo-1514282401047-d79a71a590e8?auto=format&fit=crop&w=600&q=80" },
      { name: "Kyoto", country: "Japan", stays: "580+ stays", img: "https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?auto=format&fit=crop&w=600&q=80" },
      { name: "New York", country: "USA", stays: "1,150+ stays", img: "https://images.unsplash.com/photo-1496442226666-8d4d0e62e6e9?auto=format&fit=crop&w=600&q=80" }
    ];
  %>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
    <% for(let dest of destinations) { %>
      <a href="/listings?search=<%= dest.name %>" class="group relative rounded-2xl sm:rounded-3xl overflow-hidden aspect-[3/4] shadow-sm hover:shadow-lg transition-all duration-300 block">
        <img 
          src="<%= dest.img %>" 
          alt="<%= dest.name %>" 
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
        />
        <!-- Dark gradient bottom overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-3.5 text-white">
          <h4 class="font-bold text-sm sm:text-base leading-tight"><%= dest.name %></h4>
          <span class="text-[11px] text-white/80"><%= dest.country %></span>
          <span class="inline-block mt-1.5 text-[9px] font-semibold uppercase tracking-wider bg-white/20 backdrop-blur-sm rounded-full px-2 py-0.5 w-fit">
            <%= dest.stays %>
          </span>
        </div>
      </a>
    <% } %>
  </div>
</section> 
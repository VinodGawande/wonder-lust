<%
  // Reference Image Stays Fallback Data
  const fallbackStays = [
    {
      id: "stay-1",
      title: "Santorini Cliffside Villa",
      badge: "Guest Favorite",
      rating: "4.96",
      reviews: "1.2k",
      distance: "84 km away",
      view: "Ocean view",
      location: "Santorini, Greece",
      guests: "4 guests",
      bedrooms: "2 bedrooms",
      bathrooms: "2 bathrooms",
      amenities: ["Pool", "WiFi"],
      price: 6200,
      image: "https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?auto=format&fit=crop&w=1000&q=80"
    },
    {
      id: "stay-2",
      title: "Alpine Mountain Chalet",
      badge: "Superhost",
      rating: "4.93",
      reviews: "842",
      distance: "128 km away",
      view: "Mountain view",
      location: "Zermatt, Switzerland",
      guests: "6 guests",
      bedrooms: "3 bedrooms",
      bathrooms: "2 bathrooms",
      amenities: ["Fireplace", "WiFi"],
      price: 8900,
      image: "https://images.unsplash.com/photo-1502784444187-359ac186c5bb?auto=format&fit=crop&w=1000&q=80"
    },
    {
      id: "stay-3",
      title: "Tropical Beachfront Villa",
      badge: "Guest Favorite",
      rating: "4.92",
      reviews: "980",
      distance: "64 km away",
      view: "Beach view",
      location: "Bali, Indonesia",
      guests: "8 guests",
      bedrooms: "4 bedrooms",
      bathrooms: "3 bathrooms",
      amenities: ["Pool", "WiFi"],
      price: 7500,
      image: "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=1000&q=80"
    }
  ];

  const displayListings = (typeof allListings !== 'undefined' && allListings && allListings.length > 0) ? allListings : fallbackStays;
%>

<section id="stays-grid" class="w-full my-10">
  
  <!-- Header Bar -->
  <div class="flex items-end justify-between mb-6">
    <div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Stays around the world</h2>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">Handpicked homes for your next adventure</p>
    </div>
    
    <div class="flex items-center gap-3">
      <!-- Carousel Arrow Controls -->
      <div class="hidden sm:flex items-center gap-2">
        <button type="button" class="w-8 h-8 rounded-full border border-slate-200 bg-white hover:bg-slate-50 flex items-center justify-center text-slate-700 shadow-sm transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button type="button" class="w-8 h-8 rounded-full border border-slate-200 bg-white hover:bg-slate-50 flex items-center justify-center text-slate-700 shadow-sm transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
      <a href="/listings" class="text-xs sm:text-sm font-semibold text-[#ff4757] hover:underline flex items-center gap-1">
        <span>View all stays</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </div>

  <!-- 3-Column Desktop Grid (Exact Match with Image 1) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% for(let stay of displayListings) { %>
      <div class="group bg-white rounded-3xl border border-slate-100 shadow-[0_4px_24px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_36px_rgba(0,0,0,0.08)] transition-all duration-300 overflow-hidden flex flex-col justify-between">
        
        <!-- Image Container with Badges -->
        <div class="relative w-full aspect-[4/3] overflow-hidden bg-slate-100">
          <img 
            src="<%= (stay.image && stay.image.url) ? stay.image.url : (stay.image || 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750') %>" 
            alt="<%= stay.title %>" 
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />

          <!-- Pill Badge: Guest Favorite / Superhost -->
          <div class="absolute top-3.5 left-3.5 backdrop-blur-md bg-slate-900/80 text-white text-[11px] font-semibold px-3 py-1 rounded-full flex items-center gap-1.5 shadow-sm">
            <svg class="w-3 h-3 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <span><%= stay.badge || 'Guest Favorite' %></span>
          </div>

          <!-- Wishlist Heart Button -->
          <button type="button" class="wishlist-toggle-btn absolute top-3.5 right-3.5 w-8 h-8 rounded-full backdrop-blur-md bg-black/25 hover:bg-black/40 flex items-center justify-center text-white transition-transform active:scale-90">
            <svg class="w-4 h-4 fill-none stroke-current stroke-2 heart-icon" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          </button>
        </div>

        <!-- Card Content Body -->
        <div class="p-4 sm:p-5 flex flex-col justify-between flex-1">
          
          <div>
            <!-- Title & Star Rating -->
            <div class="flex items-start justify-between gap-2">
              <h3 class="font-bold text-slate-900 text-sm sm:text-base leading-snug line-clamp-1">
                <%= stay.title %>
              </h3>
              <div class="flex items-center gap-1 text-xs font-bold text-slate-800 shrink-0">
                <span class="text-amber-400">★</span>
                <span><%= stay.rating || '4.95' %></span>
                <span class="text-slate-400 font-normal text-[11px]">(<%= stay.reviews || '1k+' %>)</span>
              </div>
            </div>

            <!-- Subtitle specs: Distance • View • Location -->
            <p class="text-xs text-slate-500 mt-1 line-clamp-1">
              <%= stay.distance || '84 km away' %> • <%= stay.view || 'Ocean view' %> • <%= stay.location || (stay.country ? (stay.location + ', ' + stay.country) : 'Greece') %>
            </p>

            <!-- Amenities Specifications Strip -->
            <div class="flex items-center gap-3 py-2.5 my-3 border-y border-slate-100 text-[11px] text-slate-600 font-medium overflow-x-auto no-scrollbar">
              <span class="flex items-center gap-1 shrink-0">👥 <%= stay.guests || '4 guests' %></span>
              <span class="flex items-center gap-1 shrink-0">🛏️ <%= stay.bedrooms || '2 bedrooms' %></span>
              <span class="flex items-center gap-1 shrink-0">🚿 <%= stay.bathrooms || '2 bathrooms' %></span>
              <% if(stay.amenities) { %>
                <% for(let a of stay.amenities) { %>
                  <span class="flex items-center gap-1 shrink-0">✨ <%= a %></span>
                <% } %>
              <% } else { %>
                <span class="flex items-center gap-1 shrink-0">🏊 Pool</span>
                <span class="flex items-center gap-1 shrink-0">📶 WiFi</span>
              <% } %>
            </div>
          </div>

          <!-- Price & Link Button -->
          <div class="flex items-center justify-between pt-1">
            <div>
              <div class="flex items-baseline gap-1">
                <span class="text-base sm:text-lg font-extrabold text-slate-900">₹<%= Number(stay.price || 5000).toLocaleString('en-IN') %></span>
                <span class="text-xs text-slate-500 font-normal">night</span>
              </div>
              <!-- Toggleable Tax Note -->
              <span class="tax-info-indicator hidden text-[10px] font-semibold text-rose-500">incl. +18% GST</span>
            </div>

            <a href="/listings/<%= stay._id || stay.id || '' %>" class="w-8 h-8 rounded-full border border-slate-200 bg-white hover:bg-slate-900 hover:text-white flex items-center justify-center text-slate-700 transition-colors shadow-sm">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>

        </div>

      </div>
    <% } %>
  </div>

</section> 
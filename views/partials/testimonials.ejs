<!-- Testimonials Banner with Scenic Background & Card (Image 1 Match) -->
<section class="relative w-full rounded-[2.5rem] overflow-hidden min-h-[380px] sm:min-h-[440px] my-14 flex items-center p-6 sm:p-12 shadow-lg">
  
  <img 
    src="https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=2000&q=80" 
    alt="Scenic Villa Review Background" 
    class="absolute inset-0 w-full h-full object-cover z-0"
  />
  <div class="absolute inset-0 bg-black/30 z-10"></div>

  <!-- Review Card on Left -->
  <div class="relative z-20 max-w-md bg-white rounded-3xl p-6 sm:p-7 shadow-2xl border border-white/60">
    <div class="flex items-center gap-3.5 mb-3">
      <img 
        src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=140&q=80" 
        alt="Priya Sharma" 
        class="w-11 h-11 rounded-full object-cover border-2 border-slate-100 shadow-sm"
      />
      <div>
        <h5 class="font-bold text-slate-900 text-sm sm:text-base leading-tight">Priya Sharma</h5>
        <span class="text-xs text-slate-500">New Delhi, India</span>
      </div>
    </div>

    <p class="text-xs sm:text-sm text-slate-700 italic leading-relaxed">
      "WonderLust made our honeymoon absolutely magical. The villa, the view, the experience — everything was perfect!"
    </p>

    <div class="flex items-center justify-between mt-4 pt-3 border-t border-slate-100">
      <div class="text-amber-400 text-xs">★★★★★</div>
      <!-- Carousel arrows -->
      <div class="flex items-center gap-1.5">
        <button type="button" class="w-6 h-6 rounded-full border border-slate-200 flex items-center justify-center text-slate-600 hover:bg-slate-100">
          ‹
        </button>
        <button type="button" class="w-6 h-6 rounded-full border border-slate-200 flex items-center justify-center text-slate-600 hover:bg-slate-100">
          ›
        </button>
      </div>
    </div>
  </div>

</section>
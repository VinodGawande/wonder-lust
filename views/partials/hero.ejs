<!-- Hero Showcase with Sunset Villa Background -->
<section class="relative w-full rounded-[2.5rem] overflow-hidden shadow-2xl min-h-[580px] lg:min-h-[640px] flex flex-col justify-between p-6 sm:p-10 lg:p-14 text-white mt-24">
  
  <!-- Villa Background Image -->
  <img 
    src="https://images.unsplash.com/photo-1540541338287-41700207dee6?auto=format&fit=crop&w=2400&q=85" 
    alt="Luxury Sunset Villa" 
    class="absolute inset-0 w-full h-full object-cover object-center z-0"
  />

  <!-- Subtle Sunset Gradient Overlays -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-black/35 z-10"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-transparent to-transparent z-10"></div>

  <!-- FLOATING SEARCH CAPSULE (Centered at top of Hero as in Image 2) -->
  <div class="relative z-30 w-full flex justify-center pt-2 pb-6">
    <form action="/listings" method="GET" class="w-full max-w-3xl backdrop-blur-xl bg-white/90 rounded-full border border-white/80 shadow-[0_12px_40px_rgba(0,0,0,0.18)] p-1.5 flex items-center justify-between text-slate-800 transition-all hover:bg-white">
      
      <!-- Where -->
      <div class="flex-1 flex items-center gap-3 px-5 py-1.5 border-r border-slate-200">
        <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
        <div class="text-left w-full">
          <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-700">Where</label>
          <input type="text" name="search" placeholder="Search destinations" autocomplete="off" class="w-full bg-transparent text-xs font-medium text-slate-800 placeholder-slate-400 focus:outline-none">
        </div>
        <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </div>

      <!-- When -->
      <div class="hidden sm:flex flex-1 items-center gap-3 px-5 py-1.5 border-r border-slate-200 cursor-pointer">
        <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <div class="text-left w-full">
          <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-700">When</span>
          <span class="block text-xs font-medium text-slate-500">Any week</span>
        </div>
        <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </div>

      <!-- Who -->
      <div class="hidden md:flex flex-1 items-center gap-3 px-5 py-1.5 cursor-pointer">
        <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        <div class="text-left w-full">
          <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-700">Who</span>
          <span class="block text-xs font-medium text-slate-500">Add guests</span>
        </div>
        <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </div>

      <!-- Red Coral Search Button -->
      <button type="submit" class="w-11 h-11 rounded-full bg-gradient-to-tr from-[#ff4757] to-[#ff6b81] flex items-center justify-center shrink-0 text-white shadow-md shadow-[#ff4757]/40 hover:scale-105 transition-transform">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </button>
    </form>
  </div>

  <!-- Middle Hero Content & Floating Review Card -->
  <div class="relative z-20 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center my-auto">
    
    <!-- Hero Text -->
    <div class="lg:col-span-8 max-w-2xl">
      <span class="inline-block text-[11px] font-bold uppercase tracking-[0.25em] text-white/90 mb-3 drop-shadow">
        EXPLORE • STAY • EXPERIENCE
      </span>
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.08] text-white drop-shadow-md">
        Discover <br>
        <span class="font-serif italic font-normal text-[#ff6b81]">Extraordinary</span> Stays
      </h1>
      <p class="text-sm sm:text-base text-white/90 mt-4 max-w-lg font-normal drop-shadow">
        Unique homes. Unforgettable experiences. All around the world.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-4 mt-8">
        <a href="#stays-grid" class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-xs sm:text-sm font-semibold text-white bg-gradient-to-r from-[#ff4757] to-[#ff6b81] hover:brightness-110 shadow-lg shadow-[#ff4757]/40 transition-all duration-200">
          <span>Explore Stays</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>

        <!-- Watch Video Link -->
        <button type="button" class="inline-flex items-center gap-3 px-4 py-2 rounded-full text-white/90 hover:text-white transition-colors group">
          <span class="w-10 h-10 rounded-full border-2 border-white/60 bg-white/20 backdrop-blur-md flex items-center justify-center group-hover:scale-105 transition-transform">
            <svg class="w-4 h-4 fill-white translate-x-0.5" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </span>
          <div class="text-left">
            <span class="block text-xs font-semibold leading-tight">Watch video</span>
            <span class="block text-[10px] text-white/70">See the WonderLust experience</span>
          </div>
        </button>
      </div>
    </div>

    <!-- Floating Top-Right Mini Review (Image 2 Match) -->
    <div class="hidden lg:flex lg:col-span-4 justify-end">
      <div class="backdrop-blur-md bg-white/20 border border-white/40 p-4 rounded-3xl shadow-xl max-w-xs text-white">
        <div class="flex items-center gap-1 text-amber-400 text-xs mb-1">
          ★★★★★
        </div>
        <p class="text-xs font-semibold leading-snug">"Absolutely stunning! A dream stay."</p>
        <span class="block text-[10px] text-white/80 mt-1 font-medium">Sarah M.</span>
        <!-- Progress bar under review -->
        <div class="w-full bg-white/30 h-1 rounded-full mt-3 overflow-hidden">
          <div class="bg-[#ff4757] w-2/3 h-full rounded-full"></div>
        </div>
      </div>
    </div>

  </div>

  <!-- Bottom Hero Bar: Stats & Location Indicator -->
  <div class="relative z-20 pt-6 border-t border-white/20 flex flex-wrap items-end justify-between gap-6">
    
    <!-- Stats Counter Strip -->
    <div class="flex items-center gap-6 sm:gap-10">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-white/15 backdrop-blur-sm flex items-center justify-center">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        </div>
        <div>
          <span class="block text-base sm:text-lg font-bold leading-none">50K+</span>
          <span class="text-[10px] sm:text-xs text-white/70">Unique homes</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-white/15 backdrop-blur-sm flex items-center justify-center">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
        </div>
        <div>
          <span class="block text-base sm:text-lg font-bold leading-none">100+</span>
          <span class="text-[10px] sm:text-xs text-white/70">Countries</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-white/15 backdrop-blur-sm flex items-center justify-center">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </div>
        <div>
          <span class="block text-base sm:text-lg font-bold leading-none">4.9 ★</span>
          <span class="text-[10px] sm:text-xs text-white/70">Guest satisfaction</span>
        </div>
      </div>
    </div>

    <!-- Location Pin & Slider Bar -->
    <div class="hidden sm:flex flex-col items-end">
      <div class="flex items-center gap-1.5 text-xs text-white font-medium mb-1">
        <svg class="w-3.5 h-3.5 text-[#ff4757]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
        <span>Amalfi Coast, Italy</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-6 h-1 rounded-full bg-white"></span>
        <span class="w-1.5 h-1 rounded-full bg-white/40"></span>
        <span class="w-1.5 h-1 rounded-full bg-white/40"></span>
      </div>
    </div>

  </div>

</section>
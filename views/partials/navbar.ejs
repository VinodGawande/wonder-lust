<% const currentTab = (typeof activeTab !== 'undefined') ? activeTab : 'stays'; %>

<!-- Toast Notifications -->
<% if((typeof success !== 'undefined' && success && success.length > 0) || (typeof error !== 'undefined' && error && error.length > 0)) { %>
  <div id="flashToastContainer" class="fixed top-20 left-1/2 transform -translate-x-1/2 z-[100] w-full max-w-md px-4 transition-all duration-500">
    <% if(typeof success !== 'undefined' && success && success.length > 0) { %>
      <div class="bg-emerald-600 text-white px-5 py-3 rounded-2xl shadow-xl flex items-center justify-between gap-3 text-xs font-semibold backdrop-blur-md">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-circle-check text-base"></i>
          <span><%= success %></span>
        </div>
        <button onclick="this.parentElement.parentElement.remove()" class="text-white/80 hover:text-white text-sm">✕</button>
      </div>
    <% } %>
    <% if(typeof error !== 'undefined' && error && error.length > 0) { %>
      <div class="bg-rose-600 text-white px-5 py-3 rounded-2xl shadow-xl flex items-center justify-between gap-3 text-xs font-semibold backdrop-blur-md mt-2">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-circle-exclamation text-base"></i>
          <span><%= error %></span>
        </div>
        <button onclick="this.parentElement.parentElement.remove()" class="text-white/80 hover:text-white text-sm">✕</button>
      </div>
    <% } %>
  </div>
  <script>
    setTimeout(() => {
      const toast = document.getElementById("flashToastContainer");
      if(toast) {
        toast.style.opacity = '0';
        toast.style.transform = 'translate(-50%, -20px)';
        setTimeout(() => toast.remove(), 400);
      }
    }, 4000);
  </script>
<% } %>

<!-- Floating Glass Navbar -->
<header class="fixed top-0 left-0 w-full z-50 px-4 sm:px-8 lg:px-12 pt-3 pb-2 pointer-events-none">
  <nav class="max-w-7xl mx-auto backdrop-blur-xl bg-white/95 border border-slate-200/90 shadow-[0_8px_30px_rgba(0,0,0,0.06)] rounded-full px-4 sm:px-6 py-2.5 flex items-center justify-between pointer-events-auto transition-all">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group text-decoration-none">
      <div class="w-8 h-8 rounded-full border-2 border-[#ff4757] flex items-center justify-center p-1 transition-transform group-hover:rotate-45 duration-300">
        <svg viewBox="0 0 24 24" fill="none" class="w-full h-full text-[#ff4757]">
          <circle cx="12" cy="12" r="9" stroke="#ff4757" stroke-width="2" />
          <polygon points="12,3 14.5,9.5 21,12 14.5,14.5 12,21 9.5,14.5 3,12 9.5,9.5" fill="#ff4757" />
        </svg>
      </div>
      <span class="text-xl font-bold tracking-tight text-slate-900 font-sans">
        Wonder<span class="text-[#ff4757]">Lust</span>
      </span>
    </a>

    <!-- Center Navigation Tabs -->
    <div class="hidden lg:flex items-center gap-1 bg-slate-100/90 p-1 rounded-full border border-slate-200 shadow-inner">
      <a href="/listings" class="flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold transition-all <%= currentTab === 'stays' ? 'text-[#ff4757] bg-white shadow-sm border border-[#ff4757]/40' : 'text-slate-600 hover:text-slate-900' %>">
        <i class="fa-solid fa-house text-xs <%= currentTab === 'stays' ? 'text-[#ff4757]' : 'text-slate-400' %>"></i>
        <span>Stays</span>
      </a>
      <a href="/experiences" class="flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold transition-all <%= currentTab === 'experiences' ? 'text-[#ff4757] bg-white shadow-sm border border-[#ff4757]/40' : 'text-slate-600 hover:text-slate-900' %>">
        <i class="fa-solid fa-compass text-xs <%= currentTab === 'experiences' ? 'text-[#ff4757]' : 'text-slate-400' %>"></i>
        <span>Experiences</span>
      </a>
      <a href="/destinations" class="flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold transition-all <%= currentTab === 'destinations' ? 'text-[#ff4757] bg-white shadow-sm border border-[#ff4757]/40' : 'text-slate-600 hover:text-slate-900' %>">
        <i class="fa-solid fa-location-dot text-xs <%= currentTab === 'destinations' ? 'text-[#ff4757]' : 'text-slate-400' %>"></i>
        <span>Destinations</span>
      </a>
      <a href="/gift-cards" class="flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold transition-all <%= currentTab === 'gift-cards' ? 'text-[#ff4757] bg-white shadow-sm border border-[#ff4757]/40' : 'text-slate-600 hover:text-slate-900' %>">
        <i class="fa-solid fa-gift text-xs <%= currentTab === 'gift-cards' ? 'text-[#ff4757]' : 'text-slate-400' %>"></i>
        <span>Gift Cards</span>
      </a>
    </div>

    <!-- Right Controls -->
    <div class="flex items-center gap-3">
      <a href="/experiences/host" class="hidden sm:inline-block text-xs font-semibold text-white bg-gradient-to-r from-[#ff4757] to-[#ff6b81] hover:brightness-105 px-4 py-2 rounded-full shadow-sm shadow-[#ff4757]/30 transition-all">
        Host an Experience
      </a>

      <div class="hidden sm:flex items-center gap-1.5 text-xs font-semibold text-slate-700 bg-white border border-slate-200 px-3 py-1.5 rounded-full shadow-sm cursor-pointer">
        <i class="fa-solid fa-globe text-slate-500"></i>
        <span>INR ₹</span>
        <i class="fa-solid fa-chevron-down text-[10px] text-slate-400"></i>
      </div>

      <!-- User Profile Trigger & Match Dropdown Card -->
      <div class="relative" id="userMenuParent">
        <% if(typeof currUser !== 'undefined' && currUser) { %>
          <% 
            const displayName = (currUser.firstName && currUser.lastName) ? (currUser.firstName + ' ' + currUser.lastName) : (currUser.firstName || currUser.username);
            const userAvatar = currUser.avatar || "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80";
          %>
          <!-- Authenticated Pill Button -->
          <button id="userDropdownTrigger" type="button" class="flex items-center gap-2 pl-1.5 pr-2.5 py-1 rounded-full bg-white hover:bg-slate-50 border border-slate-200 shadow-sm transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#ff4757]/30">
            <img src="<%= userAvatar %>" alt="User Avatar" class="w-8 h-8 rounded-full object-cover border border-slate-200" />
            <i id="dropdownChevron" class="fa-solid fa-chevron-down text-[10px] text-slate-400 transition-transform duration-200"></i>
          </button>

          <!-- EXACT UI REFERENCE DROPDOWN -->
          <div id="userDropdownPanel" class="hidden absolute right-0 mt-3 w-72 bg-white rounded-3xl shadow-[0_15px_45px_rgba(0,0,0,0.12)] border border-slate-100 py-4 px-3 z-50 transition-all duration-200 origin-top-right">
            
            <!-- User Profile Header -->
            <div class="flex items-center gap-3 px-3 pb-3 mb-2 border-b border-slate-100">
              <img src="<%= userAvatar %>" alt="<%= displayName %>" class="w-12 h-12 rounded-full object-cover border-2 border-slate-100 shadow-sm shrink-0" />
              <div class="min-w-0">
                <h4 class="text-sm font-bold text-slate-900 truncate leading-snug"><%= displayName %></h4>
                <p class="text-xs text-slate-400 truncate leading-tight"><%= currUser.email %></p>
              </div>
            </div>

            <!-- Navigation Links List -->
            <div class="space-y-1">
              <a href="/profile" class="flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-slate-700 hover:text-[#ff4757] hover:bg-rose-50/70 transition-all group">
                <div class="flex items-center gap-3">
                  <div class="w-5 flex justify-center text-slate-400 group-hover:text-[#ff4757]">
                    <i class="fa-regular fa-user text-sm"></i>
                  </div>
                  <span>My Profile</span>
                </div>
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-300 group-hover:text-[#ff4757]"></i>
              </a>

              <a href="/saved" class="flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-slate-700 hover:text-[#ff4757] hover:bg-rose-50/70 transition-all group">
                <div class="flex items-center gap-3">
                  <div class="w-5 flex justify-center text-slate-400 group-hover:text-[#ff4757]">
                    <i class="fa-regular fa-heart text-sm"></i>
                  </div>
                  <span>Saved</span>
                </div>
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-300 group-hover:text-[#ff4757]"></i>
              </a>

              <a href="/bookings" class="flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-slate-700 hover:text-[#ff4757] hover:bg-rose-50/70 transition-all group">
                <div class="flex items-center gap-3">
                  <div class="w-5 flex justify-center text-slate-400 group-hover:text-[#ff4757]">
                    <i class="fa-regular fa-calendar-check text-sm"></i>
                  </div>
                  <span>My Bookings</span>
                </div>
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-300 group-hover:text-[#ff4757]"></i>
              </a>

              <a href="/reviews" class="flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-slate-700 hover:text-[#ff4757] hover:bg-rose-50/70 transition-all group">
                <div class="flex items-center gap-3">
                  <div class="w-5 flex justify-center text-slate-400 group-hover:text-[#ff4757]">
                    <i class="fa-regular fa-star text-sm"></i>
                  </div>
                  <span>My Reviews</span>
                </div>
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-300 group-hover:text-[#ff4757]"></i>
              </a>

              <a href="/settings" class="flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-slate-700 hover:text-[#ff4757] hover:bg-rose-50/70 transition-all group">
                <div class="flex items-center gap-3">
                  <div class="w-5 flex justify-center text-slate-400 group-hover:text-[#ff4757]">
                    <i class="fa-solid fa-gear text-sm"></i>
                  </div>
                  <span>Settings</span>
                </div>
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-300 group-hover:text-[#ff4757]"></i>
              </a>
            </div>

            <!-- Divider -->
            <div class="border-t border-slate-100 my-2"></div>

            <!-- Real Logout Handler -->
            <a href="/logout" class="flex items-center gap-3 px-3.5 py-2.5 rounded-2xl text-xs font-bold text-slate-700 hover:text-[#ff4757] hover:bg-rose-50/70 transition-all group">
              <div class="w-5 flex justify-center text-slate-400 group-hover:text-[#ff4757]">
                <i class="fa-solid fa-arrow-right-from-bracket text-sm"></i>
              </div>
              <span>Logout</span>
            </a>

          </div>
        <% } else { %>
          <!-- Unauthenticated State -->
          <div class="flex items-center gap-2">
            <a href="/login" class="px-4 py-2 rounded-full text-xs font-bold text-slate-700 hover:bg-slate-100 transition-colors">Log In</a>
            <a href="/signup" class="px-4 py-2 rounded-full text-xs font-bold text-white bg-[#ff4757] hover:brightness-105 shadow-sm transition-all">Sign Up</a>
          </div>
        <% } %>
      </div>

    </div>
  </nav>
</header>

<script>
  (function initProfileDropdown() {
    const trigger = document.getElementById("userDropdownTrigger");
    const panel = document.getElementById("userDropdownPanel");
    const chevron = document.getElementById("dropdownChevron");
    const parent = document.getElementById("userMenuParent");

    if (!trigger || !panel) return;

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      const isHidden = panel.classList.toggle("hidden");
      if (chevron) {
        chevron.style.transform = isHidden ? "rotate(0deg)" : "rotate(180deg)";
      }
    });

    document.addEventListener("click", (e) => {
      if (parent && !parent.contains(e.target)) {
        panel.classList.add("hidden");
        if (chevron) chevron.style.transform = "rotate(0deg)";
      }
    });
  })();
</script>
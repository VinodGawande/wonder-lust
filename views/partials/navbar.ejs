<% const currentTab = (typeof activeTab !== 'undefined') ? activeTab : 'stays'; %>

<!-- Force Clean Light Mode on Every Page -->
<script>
  (function() {
    document.documentElement.classList.remove('dark');
  })();
</script>

<!-- Top Global Animated Toast Notification for Flash Messages -->
<% if((typeof success !== 'undefined' && success && success.length > 0) || (typeof error !== 'undefined' && error && error.length > 0)) { %>
  <div id="flashToastContainer" class="fixed top-20 left-1/2 transform -translate-x-1/2 z-[100] w-full max-w-md px-4 transition-all duration-500">
    <% if(typeof success !== 'undefined' && success && success.length > 0) { %>
      <div class="bg-emerald-600 text-white px-5 py-3 rounded-2xl shadow-2xl flex items-center justify-between gap-3 text-xs font-semibold backdrop-blur-md">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-circle-check text-base"></i>
          <span><%= success %></span>
        </div>
        <button onclick="this.parentElement.parentElement.remove()" class="text-white/80 hover:text-white text-sm">✕</button>
      </div>
    <% } %>
    <% if(typeof error !== 'undefined' && error && error.length > 0) { %>
      <div class="bg-rose-600 text-white px-5 py-3 rounded-2xl shadow-2xl flex items-center justify-between gap-3 text-xs font-semibold backdrop-blur-md mt-2">
        <div class="flex items-center gap-2">
          <i class="fa-solid fa-circle-exclamation text-base"></i>
          <span><%= error %></span>
        </div>
        <button onclick="this.parentElement.parentElement.remove()" class="text-white/80 hover:text-white text-sm">✕</button>
      </div>
    <% } %>
  </div>
  <script>
    setTimeout(() => {
      const toast = document.getElementById("flashToastContainer");
      if(toast) {
        toast.style.opacity = '0';
        toast.style.transform = 'translate(-50%, -20px)';
        setTimeout(() => toast.remove(), 500);
      }
    }, 4500);
  </script>
<% } %>

<!-- Floating Clean Glass Light Navbar (Har Page Par Light Rahega) -->
<header class="fixed top-0 left-0 w-full z-50 px-4 sm:px-8 lg:px-16 pt-4 pb-2 pointer-events-none">
  <nav class="max-w-7xl mx-auto backdrop-blur-xl !bg-white/90 !border !border-slate-200/80 shadow-[0_8px_32px_rgba(0,0,0,0.06)] rounded-full px-4 sm:px-6 py-2.5 flex items-center justify-between pointer-events-auto transition-all duration-300">
    
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group text-decoration-none">
      <div class="w-9 h-9 rounded-full border-2 border-[#ff4757] flex items-center justify-center relative p-1 transition-transform group-hover:rotate-45 duration-300">
        <svg viewBox="0 0 24 24" fill="none" class="w-full h-full text-[#ff4757]">
          <circle cx="12" cy="12" r="9" stroke="#ff4757" stroke-width="1.8" />
          <polygon points="12,3 14.5,9.5 21,12 14.5,14.5 12,21 9.5,14.5 3,12 9.5,9.5" fill="#ff4757" />
          <circle cx="18" cy="18" r="2.2" fill="#ffffff" />
        </svg>
      </div>
      <span class="text-xl sm:text-2xl font-bold tracking-tight !text-slate-900 font-sans">
        Wonder<span class="text-[#ff4757]">Lust</span>
      </span>
    </a>

    <!-- Center Navigation Tabs -->
    <div class="hidden lg:flex items-center gap-1 !bg-slate-100/90 p-1 rounded-full !border !border-slate-200 shadow-inner">
      <!-- Stays Tab -->
      <a href="/listings" class="flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold transition-all <%= currentTab === 'stays' ? '!text-[#ff4757] !bg-white shadow-sm !border !border-[#ff4757]/40' : '!text-slate-600 hover:!text-slate-900' %>">
        <svg class="w-3.5 h-3.5 <%= currentTab === 'stays' ? '!text-[#ff4757]' : '!text-slate-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        <span>Stays</span>
      </a>

      <!-- Experiences Tab -->
      <a href="/experiences" class="flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold transition-all <%= currentTab === 'experiences' ? '!text-[#ff4757] !bg-white shadow-sm !border !border-[#ff4757]/40' : '!text-slate-600 hover:!text-slate-900' %>">
        <svg class="w-3.5 h-3.5 <%= currentTab === 'experiences' ? '!text-[#ff4757]' : '!text-slate-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span>Experiences</span>
      </a>

      <!-- Destinations Tab -->
      <a href="/destinations" class="flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold transition-all <%= currentTab === 'destinations' ? '!text-[#ff4757] !bg-white shadow-sm !border !border-[#ff4757]/40' : '!text-slate-600 hover:!text-slate-900' %>">
        <svg class="w-3.5 h-3.5 <%= currentTab === 'destinations' ? '!text-[#ff4757]' : '!text-slate-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
        <span>Destinations</span>
      </a>

      <!-- Gift Cards Tab -->
      <a href="/gift-cards" class="flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold transition-all <%= currentTab === 'gift-cards' ? '!text-[#ff4757] !bg-white shadow-sm !border !border-[#ff4757]/40' : '!text-slate-600 hover:!text-slate-900' %>">
        <svg class="w-3.5 h-3.5 <%= currentTab === 'gift-cards' ? '!text-[#ff4757]' : '!text-slate-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/></svg>
        <span>Gift Cards</span>
      </a>
    </div>

    <!-- Right Controls -->
    <div class="flex items-center gap-2.5 sm:gap-3">
      
      <!-- Host an Experience Button -->
      <a href="/experiences/host" class="hidden sm:inline-block text-xs font-semibold text-white bg-gradient-to-r from-[#ff4757] to-[#ff6b81] hover:brightness-105 px-4 py-2 rounded-full shadow-sm shadow-[#ff4757]/30 transition-all duration-200">
        Host an Experience
      </a>

      <!-- Currency Display -->
      <div class="hidden sm:flex items-center gap-1.5 text-xs font-medium !text-slate-700 !bg-white hover:!bg-slate-50 !border !border-slate-200 px-3 py-1.5 rounded-full shadow-sm">
        <span>INR ₹</span>
      </div>

      <!-- Profile & Authentication Dropdown -->
      <div class="relative" id="profileDropdownParent">
        <button id="profileDropdownBtn" type="button" class="flex items-center gap-2 p-1.5 pl-2 pr-3 rounded-full !bg-white hover:!bg-slate-50 !border !border-slate-200 shadow-sm transition-all cursor-pointer">
          <% if(typeof currUser !== 'undefined' && currUser) { %>
            <div class="w-7 h-7 rounded-full bg-[#ff4757] text-white flex items-center justify-center text-xs font-extrabold uppercase shadow-sm">
              <%= (currUser.firstName && currUser.firstName[0]) ? currUser.firstName[0] : currUser.username[0] %>
            </div>
            <span class="text-xs font-bold !text-slate-800 max-w-[100px] truncate hidden sm:inline-block">
              <%= currUser.firstName || currUser.username.split('@')[0] %>
            </span>
          <% } else { %>
            <div class="w-7 h-7 rounded-full !bg-slate-100 !text-slate-500 flex items-center justify-center text-xs">
              <i class="fa-solid fa-user"></i>
            </div>
            <span class="text-xs font-semibold !text-slate-700 hidden sm:inline-block">Account</span>
          <% } %>
          <svg class="w-3 h-3 !text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>

        <!-- Dropdown Menu Box -->
        <div id="profileDropdownMenu" class="hidden absolute right-0 mt-2 w-52 !bg-white rounded-2xl shadow-2xl !border !border-slate-100 py-2 z-50">
          <% if(typeof currUser !== 'undefined' && currUser) { %>
            <div class="px-4 py-2.5 border-b !border-slate-100 text-xs">
              <span class="!text-slate-400 block text-[10px] uppercase font-bold">Signed in as</span>
              <span class="font-bold !text-slate-800 truncate block"><%= currUser.username %></span>
            </div>
            <a href="/listings/new" class="block px-4 py-2 text-xs font-medium !text-slate-700 hover:!bg-slate-50">List your home</a>
            <a href="/experiences/host" class="block px-4 py-2 text-xs font-medium !text-slate-700 hover:!bg-slate-50">Host an experience</a>
            <a href="/logout" class="block px-4 py-2 text-xs font-bold text-[#ff4757] hover:!bg-rose-50 border-t !border-slate-100 mt-1">Log out</a>
          <% } else { %>
            <a href="/signup" class="block px-4 py-2 text-xs font-bold text-[#ff4757] hover:!bg-rose-50">Create account (Sign up)</a>
            <a href="/login" class="block px-4 py-2 text-xs font-medium !text-slate-700 hover:!bg-slate-50">Log in</a>
          <% } %>
        </div>
      </div>

    </div>
  </nav>
</header>

<script>
  (function initNavbarControls() {
    // Profile Dropdown Toggle Handler
    document.addEventListener("click", function(e) {
      const profBtn = e.target.closest("#profileDropdownBtn");
      const menu = document.getElementById("profileDropdownMenu");
      if (profBtn && menu) {
        menu.classList.toggle("hidden");
        return;
      }
      if (menu && !e.target.closest("#profileDropdownParent")) {
        menu.classList.add("hidden");
      }
    });
  })();
</script>
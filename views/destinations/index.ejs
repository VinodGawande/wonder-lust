<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WonderLust | Explore the World, One Destination at a Time</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@1,600&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class', // Enables dark mode class strategy
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            serif: ['"Playfair Display"', 'serif'],
          }
        }
      }
    }
  </script>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="bg-[#fafafa] dark:bg-[#0b1329] font-sans text-slate-900 dark:text-slate-100 antialiased selection:bg-[#ff4757]/20 selection:text-[#ff4757] transition-colors duration-300">

  <!-- Top Glass Navbar -->
  <%- include("../partials/navbar.ejs", { activeTab: "destinations" }) %>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 1. HERO SECTION -->
    <section class="relative w-full rounded-[2.5rem] overflow-hidden shadow-2xl min-h-[520px] lg:min-h-[560px] flex flex-col justify-between p-6 sm:p-10 lg:p-14 text-white mt-24">
      <img 
        src="https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?auto=format&fit=crop&w=2400&q=85" 
        alt="Santorini Sunset Destination" 
        class="absolute inset-0 w-full h-full object-cover object-center z-0"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/30 z-10"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-transparent to-transparent z-10"></div>

      <!-- Hero Heading Content -->
      <div class="relative z-20 max-w-2xl mt-4">
        <span class="inline-block text-[11px] font-bold uppercase tracking-[0.25em] text-white/90 mb-3 drop-shadow">
          EXPLORE • DISCOVER • BELONG
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-[1.1] text-white drop-shadow-md">
          Explore the World,<br>
          <span class="font-serif italic font-normal text-[#ff6b81]">One Destination</span> at a Time
        </h1>
        <p class="text-xs sm:text-sm text-white/90 mt-4 max-w-lg font-normal leading-relaxed drop-shadow">
          Discover breathtaking places, unique stays and unforgettable experiences across the world.
        </p>
      </div>

      <!-- Search Capsule -->
      <div class="relative z-30 w-full flex justify-center mt-8">
        <form action="/destinations/search" method="GET" class="w-full max-w-3xl backdrop-blur-xl bg-white/95 dark:bg-slate-900/90 rounded-full border border-white/80 dark:border-slate-700 shadow-[0_12px_40px_rgba(0,0,0,0.18)] p-1.5 flex items-center justify-between text-slate-800 dark:text-white">
          
          <!-- WHERE -->
          <div class="flex-1 flex items-center gap-3 px-5 py-2 border-r border-slate-200 dark:border-slate-700">
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
            <div class="text-left w-full">
              <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Where</label>
              <input type="text" name="where" value="<%= (typeof searchParams !== 'undefined' && searchParams.where) ? searchParams.where : '' %>" placeholder="Search destinations" autocomplete="off" class="w-full bg-transparent text-xs font-medium text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none">
            </div>
          </div>

          <!-- WHEN -->
          <div class="hidden sm:flex flex-1 items-center gap-3 px-5 py-2 border-r border-slate-200 dark:border-slate-700">
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <div class="text-left w-full">
              <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">When</label>
              <input type="text" name="when" placeholder="Any week" onfocus="(this.type='date')" onblur="(this.type='text')" class="w-full bg-transparent text-xs font-medium text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none">
            </div>
          </div>

          <!-- GUESTS -->
          <div class="hidden md:flex flex-1 items-center gap-3 px-5 py-2">
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            <div class="text-left w-full">
              <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Guests</label>
              <input type="number" name="guests" min="1" max="20" placeholder="Add guests" class="w-full bg-transparent text-xs font-medium text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none">
            </div>
          </div>

          <!-- Search Button -->
          <button type="submit" class="w-11 h-11 rounded-full bg-gradient-to-tr from-[#ff4757] to-[#ff6b81] flex items-center justify-center shrink-0 text-white shadow-md shadow-[#ff4757]/40 hover:scale-105 active:scale-95 transition-transform">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </button>
        </form>
      </div>

    </section>

    <!-- 2. DESTINATION CATEGORIES (Dark mode ready) -->
    <div class="w-full my-6">
      <div class="bg-white dark:bg-slate-900 rounded-3xl sm:rounded-full border border-slate-200/80 dark:border-slate-800 shadow-[0_4px_20px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_20px_rgba(0,0,0,0.2)] p-3 px-6 flex items-center justify-between gap-4 transition-colors">
        
        <div class="flex items-center gap-8 overflow-x-auto no-scrollbar py-1 w-full justify-between sm:justify-start">
          <% 
            const catList = [
              { name: "All Destinations", icon: "🌐" },
              { name: "Beach", icon: "🏖️" },
              { name: "Mountain", icon: "⛰️" },
              { name: "Cities", icon: "🏙️" },
              { name: "Islands", icon: "🏝️" },
              { name: "Cultural", icon: "🏛" },
              { name: "Adventure", icon: "🧗" },
              { name: "Romantic", icon: "🤍" },
              { name: "Family", icon: "👨‍👩‍👦" },
              { name: "Nature", icon: "🌿" },
              { name: "Luxury", icon: "🍸" },
              { name: "Budget", icon: "🏷️" }
            ];
          %>

          <% for(let cat of catList) { %>
            <a href="/destinations?category=<%= encodeURIComponent(cat.name) %>" 
               class="flex flex-col items-center gap-1 shrink-0 text-decoration-none transition-transform hover:-translate-y-0.5 <%= (typeof activeCategory !== 'undefined' && activeCategory === cat.name) ? 'text-[#ff4757]' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white' %>">
              <span class="text-base"><%= cat.icon %></span>
              <span class="text-[11px] font-semibold whitespace-nowrap <%= (typeof activeCategory !== 'undefined' && activeCategory === cat.name) ? 'border-b-2 border-[#ff4757] pb-0.5 font-bold text-[#ff4757]' : '' %>">
                <%= cat.name %>
              </span>
            </a>
          <% } %>
        </div>

      </div>
    </div>

    <!-- 3. POPULAR DESTINATIONS SECTION -->
    <section class="w-full my-10">
      
      <div class="flex items-end justify-between mb-5">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Popular Destinations</h2>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">Explore the most loved destinations by travelers</p>
        </div>
        
        <div class="flex items-center gap-3">
          <div class="hidden sm:flex items-center gap-2">
            <button type="button" id="popularPrevBtn" class="w-8 h-8 rounded-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 active:scale-90 flex items-center justify-center text-slate-700 dark:text-slate-200 shadow-sm transition-all">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button type="button" id="popularNextBtn" class="w-8 h-8 rounded-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 active:scale-90 flex items-center justify-center text-slate-700 dark:text-slate-200 shadow-sm transition-all">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
          <a href="/destinations/all" class="text-xs sm:text-sm font-semibold text-[#ff4757] hover:underline flex items-center gap-1">
            <span>View all destinations</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>

      <!-- 6-Grid Popular Cards Container -->
      <div id="popularContainer" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 overflow-x-auto no-scrollbar scroll-smooth py-1">
        <% for(let dest of popularDestinations) { %>
          <div class="group relative rounded-2xl overflow-hidden aspect-[4/5] shadow-sm hover:shadow-xl transition-all duration-300 block shrink-0">
            <a href="/destinations/<%= dest.slug %>">
              <img 
                src="<%= dest.image %>" 
                alt="<%= dest.name %>" 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
            </a>
            
            <button type="button" class="dest-wishlist-btn absolute top-2.5 right-2.5 w-7 h-7 rounded-full backdrop-blur-md bg-black/25 hover:bg-black/50 text-white flex items-center justify-center transition-transform active:scale-75">
              <i class="fa-regular fa-heart text-xs"></i>
            </button>

            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent flex flex-col justify-end p-3.5 text-white pointer-events-none">
              <div class="flex items-end justify-between pointer-events-auto">
                <a href="/destinations/<%= dest.slug %>" class="text-white text-decoration-none">
                  <h4 class="font-bold text-sm leading-tight hover:text-rose-200 transition-colors"><%= dest.name %></h4>
                  <p class="text-[11px] text-white/80 mt-0.5 leading-snug"><%= dest.country %></p>
                  <span class="text-[10px] text-white/60 block mt-1"><%= dest.stayCount %></span>
                </a>
                <a href="/destinations/<%= dest.slug %>" class="w-7 h-7 rounded-full backdrop-blur-md bg-white/20 hover:bg-[#ff4757] flex items-center justify-center text-white transition-all shrink-0">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          </div>
        <% } %>
      </div>

    </section>

    <!-- 4. TRENDING DESTINATIONS SECTION -->
    <section class="w-full my-12">
      
      <div class="flex items-end justify-between mb-5">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Trending Destinations</h2>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">Top destinations this season</p>
        </div>
        
        <div class="flex items-center gap-3">
          <div class="hidden sm:flex items-center gap-2">
            <button type="button" id="trendingPrevBtn" class="w-8 h-8 rounded-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 active:scale-90 flex items-center justify-center text-slate-700 dark:text-slate-200 shadow-sm transition-all">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button type="button" id="trendingNextBtn" class="w-8 h-8 rounded-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 active:scale-90 flex items-center justify-center text-slate-700 dark:text-slate-200 shadow-sm transition-all">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
          <a href="/destinations/all" class="text-xs sm:text-sm font-semibold text-[#ff4757] hover:underline flex items-center gap-1">
            <span>View all destinations</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>

      <!-- 6-Grid Trending Cards Container -->
      <div id="trendingContainer" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 overflow-x-auto no-scrollbar scroll-smooth py-1">
        <% for(let dest of trendingDestinations) { %>
          <div class="group relative rounded-2xl overflow-hidden aspect-[4/5] shadow-sm hover:shadow-xl transition-all duration-300 block shrink-0">
            <a href="/destinations/<%= dest.slug %>">
              <img 
                src="<%= dest.image %>" 
                alt="<%= dest.name %>" 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
            </a>

            <button type="button" class="dest-wishlist-btn absolute top-2.5 right-2.5 w-7 h-7 rounded-full backdrop-blur-md bg-black/25 hover:bg-black/50 text-white flex items-center justify-center transition-transform active:scale-75">
              <i class="fa-regular fa-heart text-xs"></i>
            </button>

            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent flex flex-col justify-end p-3.5 text-white pointer-events-none">
              <div class="flex items-end justify-between pointer-events-auto">
                <a href="/destinations/<%= dest.slug %>" class="text-white text-decoration-none">
                  <h4 class="font-bold text-sm leading-tight hover:text-rose-200 transition-colors"><%= dest.name %></h4>
                  <p class="text-[11px] text-white/80 mt-0.5 leading-snug"><%= dest.country %></p>
                  <span class="text-[10px] text-white/60 block mt-1"><%= dest.stayCount %></span>
                </a>
                <a href="/destinations/<%= dest.slug %>" class="w-7 h-7 rounded-full backdrop-blur-md bg-white/20 hover:bg-[#ff4757] flex items-center justify-center text-white transition-all shrink-0">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          </div>
        <% } %>
      </div>

    </section>

    <!-- 5. CALL TO ACTION & TRUST BADGES (With Background & Dark Mode Support) -->
    <section class="relative w-full my-12 rounded-[2.5rem] overflow-hidden shadow-sm border border-slate-200/80 dark:border-slate-800 min-h-[220px] flex items-center">
      
      <img 
        src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=2000&q=80" 
        alt="Tropical Beach Mountain Panorama" 
        class="absolute inset-0 w-full h-full object-cover object-center z-0"
      />
      <!-- Dynamic Light/Dark Overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-white/80 via-white/40 to-transparent dark:from-slate-950/90 dark:via-slate-950/60 dark:to-transparent z-10 pointer-events-none"></div>

      <!-- Content Grid -->
      <div class="relative z-20 w-full p-6 sm:p-8 lg:p-10 flex flex-col lg:flex-row items-center justify-between gap-6">
        
        <!-- Left Side -->
        <div class="max-w-md w-full text-left">
          <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
            Find your next favorite place
          </h3>
          <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 mt-2 font-medium leading-relaxed">
            From tropical islands to mountain escapes, discover destinations that match your travel style.
          </p>
          <a href="/destinations/all" class="inline-flex items-center gap-2 mt-5 px-6 py-2.5 rounded-full text-xs font-bold text-white bg-gradient-to-r from-[#ff4757] to-[#ff6b81] hover:brightness-105 shadow-md shadow-[#ff4757]/30 transition-all active:scale-95 text-decoration-none">
            <span>Explore Destinations</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>

        <!-- Right Side: Frosted Card -->
        <div class="backdrop-blur-xl bg-white/90 dark:bg-slate-900/90 border border-white/80 dark:border-slate-700 rounded-3xl p-5 sm:p-6 shadow-[0_8px_30px_rgba(0,0,0,0.06)] grid grid-cols-1 sm:grid-cols-3 gap-6 w-full lg:w-auto">
          
          <div class="flex items-start gap-3">
            <div class="w-9 h-9 rounded-2xl bg-rose-50 dark:bg-rose-950/50 text-[#ff4757] flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">
              <i class="fa-solid fa-compass"></i>
            </div>
            <div>
              <h6 class="text-xs font-bold text-slate-900 dark:text-white leading-snug">Curated Collection</h6>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 leading-snug">Handpicked destinations across the globe</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-9 h-9 rounded-2xl bg-amber-50 dark:bg-amber-950/50 text-amber-500 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">
              <i class="fa-solid fa-star"></i>
            </div>
            <div>
              <h6 class="text-xs font-bold text-slate-900 dark:text-white leading-snug">Verified Stays</h6>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 leading-snug">Quality stays in every destination</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-9 h-9 rounded-2xl bg-blue-50 dark:bg-blue-950/50 text-blue-500 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">
              <i class="fa-solid fa-book-open"></i>
            </div>
            <div>
              <h6 class="text-xs font-bold text-slate-900 dark:text-white leading-snug">Complete Travel Guide</h6>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 leading-snug">Get insights, tips and local recommendations</p>
            </div>
          </div>

        </div>

      </div>

    </section>

    <!-- 6. FOOTER -->
    <%- include("../partials/footer.ejs") %>

  </main>

  <!-- Interactive JavaScript -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // 1. Popular Carousel
      const popularContainer = document.getElementById("popularContainer");
      const popularPrev = document.getElementById("popularPrevBtn");
      const popularNext = document.getElementById("popularNextBtn");
      if (popularPrev && popularNext && popularContainer) {
        popularPrev.addEventListener("click", () => {
          popularContainer.scrollBy({ left: -300, behavior: "smooth" });
        });
        popularNext.addEventListener("click", () => {
          popularContainer.scrollBy({ left: 300, behavior: "smooth" });
        });
      }

      // 2. Trending Carousel
      const trendingContainer = document.getElementById("trendingContainer");
      const trendingPrev = document.getElementById("trendingPrevBtn");
      const trendingNext = document.getElementById("trendingNextBtn");
      if (trendingPrev && trendingNext && trendingContainer) {
        trendingPrev.addEventListener("click", () => {
          trendingContainer.scrollBy({ left: -300, behavior: "smooth" });
        });
        trendingNext.addEventListener("click", () => {
          trendingContainer.scrollBy({ left: 300, behavior: "smooth" });
        });
      }

      // 3. Heart Toggle
      const wishBtns = document.querySelectorAll(".dest-wishlist-btn");
      wishBtns.forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const icon = btn.querySelector("i");
          if (icon.classList.contains("fa-regular")) {
            icon.classList.remove("fa-regular");
            icon.classList.add("fa-solid", "text-[#ff4757]");
          } else {
            icon.classList.remove("fa-solid", "text-[#ff4757]");
            icon.classList.add("fa-regular");
          }
        });
      });
    });
  </script>
</body>
</html> 
  <!-- Client-side Interactive Carousel & Heart State Logic -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // 1. Wishlist / Heart toggle button functionality
      const heartBtns = document.querySelectorAll(".wishlist-toggle-btn");
      heartBtns.forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const svg = btn.querySelector("svg");
          if (svg.classList.contains("fill-[#ff4757]")) {
            svg.classList.remove("fill-[#ff4757]", "text-[#ff4757]");
            svg.classList.add("fill-none", "text-white");
          } else {
            svg.classList.remove("fill-none", "text-white");
            svg.classList.add("fill-[#ff4757]", "text-[#ff4757]");
          }
        });
      });

      // 2. Popular Experiences Carousel buttons
      const expContainer = document.getElementById("experiencesContainer");
      const prevExpBtn = document.getElementById("prevExpBtn");
      const nextExpBtn = document.getElementById("nextExpBtn");

      if (prevExpBtn && nextExpBtn && expContainer) {
        prevExpBtn.addEventListener("click", () => {
          expContainer.scrollBy({ left: -320, behavior: "smooth" });
        });
        nextExpBtn.addEventListener("click", () => {
          expContainer.scrollBy({ left: 320, behavior: "smooth" });
        });
      }

      // 3. Category Carousel buttons
      const catScroll = document.getElementById("categoryCardsScroll");
      const prevCatBtn = document.getElementById("prevCatBtn");
      const nextCatBtn = document.getElementById("nextCatBtn");

      if (prevCatBtn && nextCatBtn && catScroll) {
        prevCatBtn.addEventListener("click", () => {
          catScroll.scrollBy({ left: -260, behavior: "smooth" });
        });
        nextCatBtn.addEventListener("click", () => {
          catScroll.scrollBy({ left: 260, behavior: "smooth" });
        });
      }
    });
  </script>

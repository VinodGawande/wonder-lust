<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WonderLust | Unforgettable Experiences, Made for You</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@1,600&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            serif: ['"Playfair Display"', 'serif'],
          }
        }
      }
    }
  </script>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="bg-[#fafafa] font-sans text-slate-900 antialiased selection:bg-[#ff4757]/20 selection:text-[#ff4757]">

  <!-- Top Glass Navbar -->
  <%- include("../partials/navbar.ejs", { activeTab: "experiences" }) %>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 1. HERO SECTION -->
    <section class="relative w-full rounded-[2.5rem] overflow-hidden shadow-2xl min-h-[520px] lg:min-h-[560px] flex flex-col justify-between p-6 sm:p-10 lg:p-14 text-white mt-24">
      <img 
        src="https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=2400&q=85" 
        alt="Experiences Sunset" 
        class="absolute inset-0 w-full h-full object-cover object-center z-0"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/40 z-10"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-transparent to-transparent z-10"></div>

      <!-- Hero Heading -->
      <div class="relative z-20 max-w-2xl mt-4">
        <span class="inline-block text-[11px] font-bold uppercase tracking-[0.25em] text-white/90 mb-3 drop-shadow">
          EXPLORE • DISCOVER • EXPERIENCE
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-[1.1] text-white drop-shadow-md">
          Unforgettable<br>
          <span class="font-serif italic font-normal text-[#ff6b81]">Experiences,</span> Made for You
        </h1>
        <p class="text-xs sm:text-sm text-white/90 mt-4 max-w-lg font-normal leading-relaxed drop-shadow">
          Discover unique things to do, from private yacht cruises to local food tours, adventure activities and cultural experiences.
        </p>
      </div>

      <!-- Functional Search Capsule -->
      <div class="relative z-30 w-full flex justify-center mt-8">
        <form action="/experiences/search" method="GET" class="w-full max-w-3xl backdrop-blur-xl bg-white/95 rounded-full border border-white/80 shadow-[0_12px_40px_rgba(0,0,0,0.18)] p-1.5 flex items-center justify-between text-slate-800">
          
          <!-- WHERE -->
          <div class="flex-1 flex items-center gap-3 px-5 py-2 border-r border-slate-200">
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
            <div class="text-left w-full">
              <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-700">Where</label>
              <input type="text" name="where" value="<%= (typeof searchParams !== 'undefined' && searchParams.where) ? searchParams.where : '' %>" placeholder="Search locations (e.g. Italy, Maldives)" autocomplete="off" class="w-full bg-transparent text-xs font-medium text-slate-800 placeholder-slate-400 focus:outline-none">
            </div>
          </div>

          <!-- WHEN -->
          <div class="hidden sm:flex flex-1 items-center gap-3 px-5 py-2 border-r border-slate-200">
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <div class="text-left w-full">
              <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-700">When</label>
              <input type="text" name="when" placeholder="Any date" onfocus="(this.type='date')" onblur="(this.type='text')" class="w-full bg-transparent text-xs font-medium text-slate-800 placeholder-slate-400 focus:outline-none">
            </div>
          </div>

          <!-- GUESTS -->
          <div class="hidden md:flex flex-1 items-center gap-3 px-5 py-2">
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            <div class="text-left w-full">
              <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-700">Guests</label>
              <input type="number" name="guests" min="1" max="20" value="<%= (typeof searchParams !== 'undefined' && searchParams.guests) ? searchParams.guests : '' %>" placeholder="Add guests" class="w-full bg-transparent text-xs font-medium text-slate-800 placeholder-slate-400 focus:outline-none">
            </div>
          </div>

          <!-- Search Button -->
          <button type="submit" class="w-11 h-11 rounded-full bg-gradient-to-tr from-[#ff4757] to-[#ff6b81] flex items-center justify-center shrink-0 text-white shadow-md shadow-[#ff4757]/40 hover:scale-105 active:scale-95 transition-transform">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </button>
        </form>
      </div>

    </section>

    <!-- 2. HORIZONTAL CATEGORIES BAR (Active filter links) -->
    <div class="w-full my-6">
      <div class="bg-white rounded-3xl sm:rounded-full border border-slate-200/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] p-3 px-6 flex items-center justify-between gap-4">
        
        <div class="flex items-center gap-8 overflow-x-auto no-scrollbar py-1 w-full justify-between sm:justify-start">
          <% 
            const catList = [
              { name: "Trending", icon: "🔥" },
              { name: "Food & Dining", icon: "🍽️" },
              { name: "Water Activities", icon: "⛵" },
              { name: "Adventure", icon: "🧗" },
              { name: "Arts & Culture", icon: "🏛️" },
              { name: "Wellness", icon: "🧘" },
              { name: "Nightlife", icon: "🍸" },
              { name: "Tours", icon: "🗺️" },
              { name: "Photography", icon: "📷" },
              { name: "Classes", icon: "🎨" }
            ];
          %>

          <% for(let cat of catList) { %>
            <a href="/experiences?category=<%= encodeURIComponent(cat.name) %>" 
               class="flex flex-col items-center gap-1 shrink-0 text-decoration-none transition-transform hover:-translate-y-0.5 <%= (typeof activeCategory !== 'undefined' && activeCategory === cat.name) ? 'text-[#ff4757]' : 'text-slate-500 hover:text-slate-900' %>">
              <span class="text-lg"><%= cat.icon %></span>
              <span class="text-[11px] font-semibold whitespace-nowrap <%= (typeof activeCategory !== 'undefined' && activeCategory === cat.name) ? 'border-b-2 border-[#ff4757] pb-0.5' : '' %>">
                <%= cat.name %>
              </span>
            </a>
          <% } %>
        </div>

      </div>
    </div>

    <!-- 3. POPULAR EXPERIENCES SECTION -->
    <section class="w-full my-10">
      
      <div class="flex items-end justify-between mb-6">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Popular Experiences</h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">Handpicked experiences for your next adventure</p>
        </div>
        
        <!-- Controls & Carousel Navigation -->
        <div class="flex items-center gap-3">
          <div class="hidden sm:flex items-center gap-2">
            <button type="button" id="prevExpBtn" class="w-8 h-8 rounded-full border border-slate-200 bg-white hover:bg-slate-50 active:scale-95 flex items-center justify-center text-slate-700 shadow-sm transition-all">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button type="button" id="nextExpBtn" class="w-8 h-8 rounded-full border border-slate-200 bg-white hover:bg-slate-50 active:scale-95 flex items-center justify-center text-slate-700 shadow-sm transition-all">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
          <a href="/experiences" class="text-xs sm:text-sm font-semibold text-[#ff4757] hover:underline flex items-center gap-1">
            <span>View all experiences</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>

      <% if(!experiences || experiences.length === 0) { %>
        <div class="text-center py-16 bg-white rounded-3xl border border-slate-200/80 my-4">
          <div class="text-4xl mb-2">🔍</div>
          <h4 class="font-bold text-slate-800 text-lg">No experiences found for this filter</h4>
          <p class="text-xs text-slate-500 mt-1">Try resetting the location or selecting another category.</p>
          <a href="/experiences" class="inline-block mt-4 px-5 py-2 rounded-full text-xs font-semibold text-white bg-[#ff4757] shadow-sm">
            Reset Filters
          </a>
        </div>
      <% } else { %>
        
        <!-- Experience Grid Container -->
        <div id="experiencesContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 scroll-smooth">
          <% for(let exp of experiences) { %>
            <div class="group bg-white rounded-3xl border border-slate-100 shadow-[0_4px_24px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_36px_rgba(0,0,0,0.08)] transition-all duration-300 overflow-hidden flex flex-col justify-between">
              
              <!-- Card Image & Badges -->
              <div class="relative w-full aspect-[4/3] overflow-hidden bg-slate-100">
                <a href="/experiences/<%= exp.slug || exp._id %>">
                  <img 
                    src="<%= exp.image %>" 
                    alt="<%= exp.title %>" 
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                </a>

                <!-- Badge -->
                <div class="absolute top-3.5 left-3.5 backdrop-blur-md <%= exp.badge === 'New' ? 'bg-rose-500/90' : 'bg-slate-900/80' %> text-white text-[11px] font-semibold px-3 py-1 rounded-full flex items-center gap-1.5 shadow-sm">
                  <% if(exp.badge !== 'New') { %>
                    <svg class="w-3 h-3 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <% } %>
                  <span><%= exp.badge %></span>
                </div>

                <!-- Heart Toggle Button -->
                <button type="button" class="wishlist-toggle-btn absolute top-3.5 right-3.5 w-8 h-8 rounded-full backdrop-blur-md bg-black/25 hover:bg-black/40 flex items-center justify-center text-white transition-all active:scale-75">
                  <svg class="w-4 h-4 fill-none stroke-current stroke-2 heart-icon pointer-events-none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                </button>
              </div>

              <!-- Card Body -->
              <div class="p-4 sm:p-5 flex flex-col justify-between flex-1">
                <div>
                  <div class="flex items-start justify-between gap-2">
                    <a href="/experiences/<%= exp.slug || exp._id %>" class="text-decoration-none text-slate-900 hover:text-[#ff4757] transition-colors">
                      <h3 class="font-bold text-sm sm:text-base leading-snug line-clamp-1"><%= exp.title %></h3>
                    </a>
                    <div class="flex items-center gap-1 text-xs font-bold text-slate-800 shrink-0">
                      <span class="text-amber-400">★</span>
                      <span><%= exp.rating %></span>
                      <span class="text-slate-400 font-normal text-[11px]">(<%= exp.reviewCount %>)</span>
                    </div>
                  </div>

                  <p class="text-xs text-slate-500 mt-1 flex items-center gap-1">
                    <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                    <span><%= exp.location %>, <%= exp.country %></span>
                  </p>

                  <div class="flex items-center gap-4 py-2.5 my-3 border-y border-slate-100 text-[11px] text-slate-600 font-medium">
                    <span class="flex items-center gap-1">
                      <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                      <%= exp.duration %>
                    </span>
                    <span class="flex items-center gap-1">
                      <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                      Up to <%= exp.maxGuests %> guests
                    </span>
                  </div>
                </div>

                <div class="flex items-center justify-between pt-1">
                  <div>
                    <span class="text-base sm:text-lg font-extrabold text-slate-900">₹<%= Number(exp.price).toLocaleString("en-IN") %></span>
                    <span class="text-xs text-slate-500 font-normal">/ guest</span>
                  </div>
                  <a href="/experiences/<%= exp.slug || exp._id %>" class="w-8 h-8 rounded-full border border-slate-200 bg-white hover:bg-[#ff4757] hover:text-white hover:border-[#ff4757] flex items-center justify-center text-slate-700 transition-all shadow-sm">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                  </a>
                </div>

              </div>

            </div>
          <% } %>
        </div>
      <% } %>

    </section>

    <!-- 4. EXPLORE BY CATEGORY SECTION -->
    <section class="w-full my-14">
      <div class="flex items-end justify-between mb-6">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">Explore by Category</h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">Find experiences that match your interests</p>
        </div>
        <div class="flex items-center gap-3">
          <div class="hidden sm:flex items-center gap-2">
            <button type="button" id="prevCatBtn" class="w-8 h-8 rounded-full border border-slate-200 bg-white hover:bg-slate-50 flex items-center justify-center text-slate-700 shadow-sm transition-colors">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button type="button" id="nextCatBtn" class="w-8 h-8 rounded-full border border-slate-200 bg-white hover:bg-slate-50 flex items-center justify-center text-slate-700 shadow-sm transition-colors">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
          <a href="/experiences" class="text-xs sm:text-sm font-semibold text-[#ff4757] hover:underline flex items-center gap-1">
            <span>View all categories</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>

      <% 
        const categoryCards = [
          { name: "Food & Dining", count: "240+ experiences", img: "https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=500&q=80" },
          { name: "Water Activities", count: "180+ experiences", img: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=500&q=80" },
          { name: "Adventure", count: "320+ experiences", img: "https://images.unsplash.com/photo-1501555088652-021faa106b9b?auto=format&fit=crop&w=500&q=80" },
          { name: "Arts & Culture", count: "260+ experiences", img: "https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?auto=format&fit=crop&w=500&q=80" },
          { name: "Wellness", count: "140+ experiences", img: "https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=500&q=80" },
          { name: "Nightlife", count: "180+ experiences", img: "https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?auto=format&fit=crop&w=500&q=80" },
          { name: "Tours", count: "220+ experiences", img: "https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?auto=format&fit=crop&w=500&q=80" },
          { name: "Photography", count: "120+ experiences", img: "https://images.unsplash.com/photo-1452587925148-ce544e77e70d?auto=format&fit=crop&w=500&q=80" }
        ];
      %>

      <div id="categoryCardsScroll" class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3.5 overflow-x-auto no-scrollbar py-2">
        <% for(let card of categoryCards) { %>
          <a href="/experiences?category=<%= encodeURIComponent(card.name) %>" class="group relative rounded-2xl overflow-hidden aspect-[3/4] shadow-sm hover:shadow-lg transition-all duration-300 block shrink-0">
            <img src="<%= card.img %>" alt="<%= card.name %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent flex flex-col justify-end p-2.5 text-white text-center">
              <h5 class="font-bold text-xs leading-tight"><%= card.name %></h5>
              <span class="text-[10px] text-white/70 mt-0.5"><%= card.count %></span>
            </div>
          </a>
        <% } %>
      </div>

    </section>

    <!-- 5. CTA SECTION (UPDATED: Panoramic Travel Image Background with Frosted Glass Badge Card) -->
    <section class="relative w-full my-12 rounded-[2.5rem] overflow-hidden shadow-sm border border-slate-200/80 min-h-[220px] flex items-center">
      
      <!-- Background Luxury Ocean & Sunset Image -->
      <img 
        src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=2000&q=80" 
        alt="Make it a trip to remember panorama" 
        class="absolute inset-0 w-full h-full object-cover object-center z-0"
      />
      <!-- Soft white gradient overlay taaki left text easily readable ho -->
      <div class="absolute inset-0 bg-gradient-to-r from-white/75 via-white/35 to-transparent z-10 pointer-events-none"></div>

      <!-- Content Container -->
      <div class="relative z-20 w-full p-6 sm:p-8 lg:p-10 flex flex-col lg:flex-row items-center justify-between gap-6">
        
        <!-- Left Side: Heading, Subtitle & Button -->
        <div class="max-w-md w-full text-left">
          <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight">
            Make it a trip to remember
          </h3>
          <p class="text-xs sm:text-sm text-slate-700 mt-2 font-medium leading-relaxed">
            Book experiences and create stories that last a lifetime with local expert hosts.
          </p>
          <a href="/experiences" class="inline-flex items-center gap-2 mt-5 px-6 py-2.5 rounded-full text-xs font-bold text-white bg-gradient-to-r from-[#ff4757] to-[#ff6b81] hover:brightness-105 shadow-md shadow-[#ff4757]/30 transition-all active:scale-95 text-decoration-none">
            <span>Explore Experiences</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>

        <!-- Right Side: Frosted Glass Box with 4 Trust Badges -->
        <div class="backdrop-blur-xl bg-white/90 border border-white/80 rounded-3xl p-5 sm:p-6 shadow-[0_8px_30px_rgba(0,0,0,0.06)] grid grid-cols-2 sm:grid-cols-4 gap-4 w-full lg:w-auto">
          
          <div class="flex items-center gap-3 p-1.5">
            <div class="w-9 h-9 rounded-2xl bg-rose-50 text-[#ff4757] flex items-center justify-center text-sm font-bold shrink-0">
              <i class="fa-solid fa-users"></i>
            </div>
            <div>
              <h6 class="text-xs font-bold text-slate-900 leading-snug">Local Experts</h6>

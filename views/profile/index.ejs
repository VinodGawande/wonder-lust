<% layout("/layouts/boilerplate") %>

<% 
  const currentUserName = (user.firstName && user.lastName) 
    ? (user.firstName + ' ' + user.lastName) 
    : (user.firstName || user.username || "");
  const currentUserAvatar = user.avatar || "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80";
  const memberDate = (user.createdAt || user.lastLogin || new Date()).toLocaleDateString("en-US", { month: "long", year: "numeric" });
%>

<div class="relative w-full antialiased font-sans text-slate-800 bg-[#f8f9fb] min-h-screen pb-20">

  <div class="relative w-full h-52 sm:h-60 overflow-hidden">
    <img 
      src="https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?auto=format&fit=crop&w=2000&q=85" 
      alt="Scenic Mediterranean Panorama" 
      class="w-full h-full object-cover object-center filter brightness-[0.92]"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-[#f8f9fb]"></div>

    <button
      type="button"
      class="absolute right-4 sm:right-6 top-5 sm:top-6 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/85 text-slate-700 border border-slate-200 shadow-sm text-xs font-semibold hover:bg-white transition-all"
    >
      <i class="fa-regular fa-image text-[#ff4757]"></i>
      <span>Change Cover Photo</span>
    </button>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex flex-col justify-end pb-7 relative z-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">My Profile</h1>
      <p class="text-xs sm:text-sm text-slate-600 font-medium mt-1">Manage your personal information, travel preferences and account settings.</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-3 sm:-mt-6">
    <div class="bg-[#f3f3f5] rounded-[28px] border border-slate-200/80 shadow-[0_8px_28px_rgba(15,23,42,0.06)] p-5 sm:p-6">
      <div class="flex items-start justify-between gap-4">
        <div class="flex items-center gap-4">
          <div class="relative w-20 h-20 sm:w-24 sm:h-24 rounded-full overflow-hidden border-4 border-white shadow-lg bg-slate-100 shrink-0">
            <img id="currentAvatarImg" src="<%= currentUserAvatar %>" alt="<%= currentUserName %>" class="w-full h-full object-cover" />
          </div>

          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight"><%= currentUserName %></h2>
              <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-bold">
                <i class="fa-solid fa-check"></i>
                Verified
              </span>
            </div>
            <p class="text-sm text-slate-500 mt-1">Full Stack Developer • Travel Enthusiast</p>

            <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-slate-500">
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-location-dot text-slate-400"></i>
                <span><%= user.location || 'Indore, Madhya Pradesh' %></span>
              </div>
              <div class="flex items-center gap-2">
                <i class="fa-regular fa-envelope text-slate-400"></i>
                <span><%= user.email %></span>
              </div>
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-phone text-slate-400"></i>
                <span><%= user.phone || '+91 98765 43210' %></span>
              </div>
              <div class="flex items-center gap-2">
                <i class="fa-regular fa-calendar text-slate-400"></i>
                <span>Member since <%= memberDate %></span>
              </div>
            </div>

            <p class="mt-4 max-w-2xl text-sm text-slate-600 leading-relaxed"><%= user.bio || 'Passionate about exploring new places, meeting new people and experiencing different cultures. Always looking for my next adventure!' %></p>
          </div>
        </div>

        <button
          type="button"
          id="editProfileToggleBtn"
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full border border-[#ff4757]/30 bg-white/90 text-[#ff4757] text-xs font-bold shadow-sm transition-all hover:bg-white"
        >
          <i class="fa-solid fa-pen text-[10px]"></i>
          <span>Edit Profile</span>
        </button>
      </div>
    </div>

    <div class="mt-8 grid grid-cols-1 xl:grid-cols-[1.5fr_0.9fr] gap-6 items-start">
      <section class="bg-white rounded-[28px] border border-slate-200/80 shadow-[0_8px_28px_rgba(15,23,42,0.04)] p-5 sm:p-6">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-9 h-9 rounded-xl bg-rose-50 text-[#ff4757] flex items-center justify-center">
            <i class="fa-regular fa-user"></i>
          </div>
          <div>
            <h3 class="text-xl font-extrabold text-slate-900">Personal Information</h3>
            <p class="text-xs text-slate-400">Update your details to keep your profile up to date.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Full Name</label>
            <input type="text" id="fullNameInput" value="<%= currentUserName %>" readonly class="w-full px-3.5 py-2.5 rounded-xl border border-transparent bg-slate-50 text-xs font-medium text-slate-600 cursor-default transition-all" />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Email Address</label>
            <div class="relative">
              <input type="email" value="<%= user.email %>" disabled class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-xs font-medium text-slate-400 cursor-not-allowed" />
              <span class="absolute right-3 top-1/2 -translate-y-1/2 inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-600 border border-emerald-200 text-[9px] font-bold">Verified</span>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Phone Number</label>
            <div class="flex items-center rounded-xl border border-slate-200 bg-white overflow-hidden transition-all">
              <div class="flex items-center gap-1.5 px-3 py-2.5 bg-slate-50 border-r border-slate-200 text-xs font-semibold text-slate-700 shrink-0">
                <span class="text-sm">🇮🇳</span>
                <span>+91</span>
              </div>
              <input type="text" id="phoneInput" value="<%= user.phone ? user.phone.replace('+91', '').trim() : '98765 43210' %>" readonly class="w-full px-3 py-2.5 bg-slate-50 text-xs font-medium text-slate-600 cursor-default transition-all focus:outline-none" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Location</label>
            <div class="relative">
              <i class="fa-solid fa-location-dot absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
              <input type="text" id="locationInput" value="<%= user.location || 'Indore, Madhya Pradesh' %>" readonly class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-transparent bg-slate-50 text-xs font-medium text-slate-600 cursor-default transition-all" />
            </div>
          </div>

          <div class="md:col-span-2">
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Bio</label>
            <textarea id="bioTextarea" rows="4" maxlength="300" readonly class="w-full p-3.5 rounded-xl border border-transparent bg-slate-50 text-xs font-medium text-slate-600 cursor-default resize-none leading-relaxed transition-all"><%= user.bio || '' %></textarea>
            <div class="flex justify-end text-[10px] text-slate-400 mt-1"><span id="bioCharCount">0</span>/300</div>
          </div>
        </div>

        <div id="actionButtonsBar" class="hidden mt-6 flex items-center justify-end gap-3">
          <button type="button" id="cancelProfileBtn" class="px-5 py-2.5 rounded-full border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 transition-all cursor-pointer">Cancel</button>
          <button type="button" id="saveProfileBtn" class="px-6 py-2.5 rounded-full text-xs font-bold text-white bg-gradient-to-r from-[#ff4757] via-[#ff5252] to-[#ff6b81] hover:brightness-105 active:scale-95 shadow-md shadow-[#ff4757]/30 transition-all cursor-pointer">Save Changes</button>
        </div>
      </section>

      <aside class="space-y-6">
        <div class="bg-white rounded-[28px] border border-slate-200/80 shadow-[0_8px_28px_rgba(15,23,42,0.04)] p-5 sm:p-6">
          <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
            <div class="w-9 h-9 rounded-xl bg-rose-50 text-[#ff4757] flex items-center justify-center">
              <i class="fa-regular fa-image"></i>
            </div>
            <div>
              <h3 class="text-xl font-extrabold text-slate-900">Profile Photo</h3>
              <p class="text-[11px] text-slate-400">This photo will be visible to hosts and other travelers.</p>
            </div>
          </div>

          <div class="flex flex-col items-center pt-5">
            <div class="relative">
              <div class="w-32 h-32 rounded-full overflow-hidden border-4 border-rose-100 shadow-lg bg-slate-100">
                <img id="currentAvatarImgAlt" src="<%= currentUserAvatar %>" alt="<%= currentUserName %>" class="w-full h-full object-cover" />
              </div>
              <button type="button" onclick="document.getElementById('avatarFileInput').click()" class="absolute -bottom-1 -right-2 w-9 h-9 rounded-full bg-white border border-slate-200 text-[#ff4757] shadow-md hover:bg-slate-50 flex items-center justify-center transition-all">
                <i class="fa-solid fa-camera"></i>
              </button>
            </div>

            <div class="mt-5 flex gap-3 w-full">
              <button type="button" id="changePhotoBtn" class="flex-1 inline-flex items-center justify-center gap-2 px-3 py-2.5 rounded-full border border-[#ff4757]/30 bg-rose-50 text-[#ff4757] text-xs font-bold shadow-sm transition-all hover:bg-rose-100">
                <i class="fa-solid fa-arrow-up-from-bracket"></i>
                <span>Change Photo</span>
              </button>
              <button type="button" id="removePhotoBtn" class="flex-1 inline-flex items-center justify-center gap-2 px-3 py-2.5 rounded-full border border-slate-200 bg-white text-slate-700 text-xs font-bold shadow-sm transition-all hover:bg-slate-50">
                <i class="fa-regular fa-trash-can"></i>
                <span>Remove</span>
              </button>
            </div>

            <p class="mt-4 text-[10px] text-slate-400">JPG, PNG or WEBP. Max size 5MB.</p>
          </div>
        </div>

        <div class="bg-[#f2f7f6] rounded-[28px] border border-slate-200/80 shadow-[0_8px_28px_rgba(15,23,42,0.04)] p-5 sm:p-6">
          <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
            <div class="w-9 h-9 rounded-xl bg-white text-[#ff4757] flex items-center justify-center shadow-sm">
              <i class="fa-solid fa-heart"></i>
            </div>
            <div>
              <h3 class="text-xl font-extrabold text-slate-900">Travel Preferences</h3>
              <p class="text-[11px] text-slate-400">Help us personalize your travel experience.</p>
            </div>
          </div>

          <div class="mt-4 flex flex-wrap gap-2">
            <span class="px-3 py-2 rounded-full bg-white text-slate-700 border border-slate-200 text-xs font-semibold">Adventure</span>
            <span class="px-3 py-2 rounded-full bg-white text-slate-700 border border-slate-200 text-xs font-semibold">Beaches</span>
            <span class="px-3 py-2 rounded-full bg-white text-slate-700 border border-slate-200 text-xs font-semibold">Nature</span>
            <span class="px-3 py-2 rounded-full bg-white text-slate-700 border border-slate-200 text-xs font-semibold">Mountains</span>
            <span class="px-3 py-2 rounded-full bg-white text-slate-700 border border-slate-200 text-xs font-semibold">Culture</span>
            <span class="px-3 py-2 rounded-full bg-white text-slate-700 border border-slate-200 text-xs font-semibold">Food</span>
            <button class="px-3 py-2 rounded-full bg-rose-50 text-[#ff4757] border border-rose-100 text-xs font-bold">+ Add Preference</button>
          </div>
        </div>
      </aside>
    </div>

    <div class="mt-8 grid grid-cols-1 xl:grid-cols-[1.2fr_0.8fr_0.8fr] gap-6 items-start">
      <div class="bg-white rounded-[28px] border border-slate-200/80 shadow-[0_8px_28px_rgba(15,23,42,0.04)] p-5 sm:p-6">
        <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
          <div class="w-9 h-9 rounded-xl bg-rose-50 text-[#ff4757] flex items-center justify-center">
            <i class="fa-solid fa-shield-heart"></i>
          </div>
          <div>
            <h3 class="text-xl font-extrabold text-slate-900">Account Information</h3>
            <p class="text-[11px] text-slate-400">Some details about your account.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-5">
          <div class="flex items-center gap-3 bg-slate-50 rounded-2xl border border-slate-100 p-3">
            <div class="w-9 h-9 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-slate-500"><i class="fa-regular fa-envelope"></i></div>
            <div>
              <p class="text-[10px] uppercase tracking-wide text-slate-400 font-bold">Email</p>
              <p class="text-xs font-bold text-slate-800"><%= user.email %></p>
            </div>
          </div>

          <div class="flex items-center gap-3 bg-slate-50 rounded-2xl border border-slate-100 p-3">
            <div class="w-9 h-9 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-slate-500"><i class="fa-regular fa-calendar"></i></div>
            <div>
              <p class="text-[10px] uppercase tracking-wide text-slate-400 font-bold">Member Since</p>
              <p class="text-xs font-bold text-slate-800"><%= memberDate %></p>
            </div>
          </div>

          <div class="flex items-center gap-3 bg-slate-50 rounded-2xl border border-slate-100 p-3">
            <div class="w-9 h-9 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-slate-500"><i class="fa-regular fa-circle-check"></i></div>
            <div>
              <p class="text-[10px] uppercase tracking-wide text-slate-400 font-bold">Status</p>
              <p class="text-xs font-bold text-slate-800"><%= user.accountStatus || 'Active' %></p>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-[28px] border border-slate-200/80 shadow-[0_8px_28px_rgba(15,23,42,0.04)] p-5 sm:p-6">
        <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
          <div class="w-9 h-9 rounded-xl bg-rose-50 text-[#ff4757] flex items-center justify-center">
            <i class="fa-solid fa-chart-column"></i>
          </div>
          <div>
            <h3 class="text-xl font-extrabold text-slate-900">Travel Stats</h3>
            <p class="text-[11px] text-slate-400">Your journey with WonderLust.</p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 mt-5">
          <div class="rounded-2xl bg-slate-50 border border-slate-100 p-3 text-center">
            <div class="text-slate-500 mb-2"><i class="fa-solid fa-bed"></i></div>
            <div class="text-2xl font-extrabold text-slate-900">5</div>
            <div class="text-[10px] text-slate-400">Stays Booked</div>
          </div>
          <div class="rounded-2xl bg-slate-50 border border-slate-100 p-3 text-center">
            <div class="text-slate-500 mb-2"><i class="fa-solid fa-compass-drafting"></i></div>
            <div class="text-2xl font-extrabold text-slate-900">2</div>
            <div class="text-[10px] text-slate-400">Experiences</div>
          </div>
          <div class="rounded-2xl bg-slate-50 border border-slate-100 p-3 text-center">
            <div class="text-slate-500 mb-2"><i class="fa-solid fa-heart"></i></div>
            <div class="text-2xl font-extrabold text-slate-900">12</div>
            <div class="text-[10px] text-slate-400">Saved Items</div>
          </div>
          <div class="rounded-2xl bg-slate-50 border border-slate-100 p-3 text-center">
            <div class="text-slate-500 mb-2"><i class="fa-solid fa-star"></i></div>
            <div class="text-2xl font-extrabold text-slate-900">8</div>
            <div class="text-[10px] text-slate-400">Reviews</div>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-[28px] border border-slate-200/80 shadow-[0_8px_28px_rgba(15,23,42,0.04)] p-5 sm:p-6">
        <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
          <div class="w-9 h-9 rounded-xl bg-rose-50 text-[#ff4757] flex items-center justify-center">
            <i class="fa-solid fa-link"></i>
          </div>
          <div>
            <h3 class="text-xl font-extrabold text-slate-900">Social Links</h3>
            <p class="text-[11px] text-slate-400">Connect your social accounts.</p>
          </div>
        </div>

        <div class="space-y-3 mt-5">
          <div class="flex items-center justify-between bg-slate-50 rounded-2xl border border-slate-100 p-3">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-slate-600"><i class="fa-brands fa-instagram"></i></div>
              <span class="text-xs font-semibold text-slate-700">Instagram</span>
            </div>
            <button class="px-2.5 py-1.5 rounded-full border border-slate-200 bg-white text-xs font-semibold text-slate-700">Connect</button>
          </div>
          <div class="flex items-center justify-between bg-slate-50 rounded-2xl border border-slate-100 p-3">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-slate-600"><i class="fa-brands fa-github"></i></div>
              <span class="text-xs font-semibold text-slate-700">GitHub</span>
            </div>
            <button class="px-2.5 py-1.5 rounded-full border border-slate-200 bg-white text-xs font-semibold text-slate-700">Connect</button>
          </div>
          <div class="flex items-center justify-between bg-slate-50 rounded-2xl border border-slate-100 p-3">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-slate-600"><i class="fa-brands fa-linkedin-in"></i></div>
              <span class="text-xs font-semibold text-slate-700">LinkedIn</span>
            </div>
            <button class="px-2.5 py-1.5 rounded-full border border-slate-200 bg-white text-xs font-semibold text-slate-700">Connect</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <input type="file" id="avatarFileInput" accept="image/jpeg,image/png,image/webp" class="hidden">
</div>

<!-- Client-side Profile Script -->
<script src="/js/profile.js"></script>
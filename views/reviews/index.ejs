<% layout("/layouts/boilerplate") %>

<div class="relative w-full antialiased font-sans text-slate-800 bg-[#f8f9fb] min-h-screen pb-24">

  <!-- ========================================== -->
  <!-- 1. TOP HERO BANNER: Sunset Panorama        -->
  <!-- ========================================== -->
  <div class="relative w-full h-56 sm:h-64 overflow-hidden">
    <img 
      src="https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?auto=format&fit=crop&w=2000&q=85" 
      alt="Santorini Coastal Sunset Panorama" 
      class="w-full h-full object-cover object-center filter brightness-[0.92]"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-transparent to-[#f8f9fb]"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex flex-col justify-end pb-8 relative z-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">My Reviews</h1>
      <p class="text-xs sm:text-sm text-slate-600 font-medium mt-1">
        Your feedback helps travelers and hosts create better experiences.
      </p>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 2. MAIN CONTAINER & TOP TABS STRIP         -->
  <!-- ========================================== -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-2 space-y-6">
    
    <!-- Top Filter Bar -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] p-2.5 flex flex-col sm:flex-row items-center justify-between gap-4">
      
      <!-- Filter Tabs -->
      <div class="flex items-center gap-1 sm:gap-2 overflow-x-auto no-scrollbar w-full sm:w-auto">
        <button type="button" onclick="filterReviewTab('all', this)" class="r-tab-pill flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-[#ff4757] bg-rose-50/70 border border-rose-100 transition-all shrink-0 cursor-pointer">
          <i class="fa-regular fa-star text-[11px]"></i>
          <span>All Reviews (<span id="allRevCount">6</span>)</span>
        </button>

        <button type="button" onclick="filterReviewTab('Stay', this)" class="r-tab-pill flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-all shrink-0 cursor-pointer">
          <i class="fa-solid fa-house text-[11px] text-slate-400"></i>
          <span>Stay Reviews (4)</span>
        </button>

        <button type="button" onclick="filterReviewTab('Experience', this)" class="r-tab-pill flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-all shrink-0 cursor-pointer">
          <i class="fa-solid fa-compass text-[11px] text-slate-400"></i>
          <span>Experience Reviews (2)</span>
        </button>
      </div>

      <!-- Right Sort Dropdown -->
      <div class="flex items-center gap-2 self-end sm:self-auto">
        <button type="button" class="flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-slate-200 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-50 shadow-sm cursor-pointer">
          <span>Newest First</span>
          <i class="fa-solid fa-chevron-down text-[9px] text-slate-400"></i>
        </button>
      </div>

    </div>

    <!-- ========================================== -->
    <!-- 3. REVIEWS 2-COLUMN GRID (CARDS + SIDEBAR) -->
    <!-- ========================================== -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- LEFT REVIEWS LIST (Col 8) -->
      <div class="lg:col-span-8 space-y-4" id="reviewCardsContainer">
        
        <% for(let r of reviews) { %>
          <div class="review-item-card bg-white rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] p-4 sm:p-5 flex flex-col md:flex-row gap-5 transition-all hover:shadow-md" data-type="<%= r.itemType %>" data-id="<%= r._id %>">
            
            <!-- Left Thumbnail with Type Tag -->
            <div class="relative w-full md:w-56 h-48 md:h-40 rounded-2xl overflow-hidden shrink-0 bg-slate-100">
              <img src="<%= r.image %>" alt="<%= r.title %>" class="w-full h-full object-cover">
              <span class="absolute top-2.5 left-2.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-black/60 text-white backdrop-blur-sm flex items-center gap-1">
                <i class="<%= r.itemType === 'Stay' ? 'fa-solid fa-house' : 'fa-solid fa-compass' %> text-[9px]"></i>
                <span><%= r.itemType %></span>
              </span>
            </div>

            <!-- Middle/Right Review Information Details -->
            <div class="flex-1 flex flex-col justify-between space-y-3">
              <div>
                
                <!-- Title Row + Date & Menu -->
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <h3 class="text-base font-extrabold text-slate-900 leading-snug"><%= r.title %></h3>
                    <p class="text-[11px] text-slate-500 flex items-center gap-1 mt-0.5">
                      <i class="fa-solid fa-location-dot text-[10px] text-slate-400"></i>
                      <span><%= r.location %></span>
                    </p>
                  </div>

                  <div class="flex items-center gap-2 text-right shrink-0">
                    <span class="text-[11px] text-slate-400 font-medium"><%= r.reviewDate %></span>
                    <button class="text-slate-400 hover:text-slate-700 text-xs px-1 cursor-pointer">⋮</button>
                  </div>
                </div>

                <!-- Stay Details & Rating Stars -->
                <div class="pt-2 space-y-1.5">
                  <p class="text-[11px] text-slate-500 flex items-center gap-1.5">
                    <i class="fa-regular fa-calendar text-[10px] text-slate-400"></i>
                    <span><%= r.stayDate %></span>
                  </p>

                  <div class="flex items-center gap-1.5 pt-0.5">
                    <div class="flex text-amber-500 text-xs gap-0.5">
                      <% for(let i = 0; i < Math.floor(r.rating); i++) { %>
                        <i class="fa-solid fa-star"></i>
                      <% } %>
                      <% if(r.rating % 1 !== 0) { %>
                        <i class="fa-solid fa-star-half-stroke"></i>
                      <% } %>
                    </div>
                    <span class="text-xs font-bold text-slate-800"><%= (r.rating).toFixed(1) %></span>
                  </div>
                </div>

                <!-- Review Paragraph -->
                <p class="review-comment-text text-xs text-slate-600 leading-relaxed font-normal pt-2">
                  <%= r.comment %>
                </p>

              </div>

              <!-- Bottom Action Button: Edit Review -->
              <div class="pt-3 border-t border-slate-100 flex items-center justify-end">
                <button 
                  type="button" 
                  class="edit-review-btn inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50 shadow-sm transition-all cursor-pointer"
                  data-review-id="<%= r._id %>"
                  data-review-title="<%= r.title %>"
                  data-review-rating="<%= r.rating %>"
                  data-review-comment="<%= r.comment %>"
                >
                  <i class="fa-solid fa-pen text-[10px] text-slate-500"></i>
                  <span>Edit Review</span>
                </button>
              </div>

            </div>

          </div>
        <% } %>

      </div>

      <!-- RIGHT SIDEBAR SUMMARY WIDGETS (Col 4) -->
      <aside class="lg:col-span-4 space-y-5">
        
        <!-- 1. Review Summary Card -->
        <div class="bg-white rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] p-6 space-y-5">
          <div class="flex items-center gap-2">
            <i class="fa-regular fa-star text-sm text-[#ff4757]"></i>
            <div>
              <h3 class="text-xs font-extrabold text-slate-900 leading-tight">Review Summary</h3>
              <p class="text-[10px] text-slate-400">A quick overview of your reviews.</p>
            </div>
          </div>

          <!-- Score Card -->
          <div class="p-5 rounded-2xl bg-[#fff5f5] text-center space-y-1.5 border border-rose-100">
            <span class="text-3xl sm:text-4xl font-extrabold text-slate-900 block leading-tight">4.6</span>
            <div class="flex items-center justify-center text-amber-500 text-xs gap-1">
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star-half-stroke"></i>
            </div>
            <span class="text-[11px] font-bold text-slate-800 block">Average Rating</span>
            <span class="text-[10px] text-slate-400 block">Based on 6 reviews</span>
          </div>

          <!-- 2 Metrics Boxes -->
          <div class="grid grid-cols-2 gap-3 pt-1">
            <div class="p-3 rounded-2xl bg-[#fafbfc] border border-slate-100 flex items-center gap-3">
              <div class="w-8 h-8 rounded-xl bg-rose-50 text-[#ff4757] flex items-center justify-center text-xs shrink-0">
                <i class="fa-solid fa-house"></i>
              </div>
              <div>
                <span class="text-sm font-extrabold text-slate-900 block leading-none">4</span>
                <span class="text-[9px] text-slate-400 font-semibold block mt-0.5">Stay Reviews</span>
              </div>
            </div>

            <div class="p-3 rounded-2xl bg-[#fafbfc] border border-slate-100 flex items-center gap-3">
              <div class="w-8 h-8 rounded-xl bg-rose-50 text-[#ff4757] flex items-center justify-center text-xs shrink-0">
                <i class="fa-solid fa-compass"></i>
              </div>
              <div>
                <span class="text-sm font-extrabold text-slate-900 block leading-none">2</span>
                <span class="text-[9px] text-slate-400 font-semibold block mt-0.5">Experience Reviews</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Rating Breakdown Card -->
        <div class="bg-white rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] p-6 space-y-4">
          <h3 class="text-xs font-extrabold text-slate-900 leading-tight">Rating Breakdown</h3>
          
          <div class="space-y-2.5 text-[11px] font-semibold text-slate-600">
            <!-- 5 stars -->
            <div class="flex items-center gap-3">
              <span class="w-12 text-slate-500">5 stars</span>
              <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
                <div class="h-full bg-[#ff4757] rounded-full" style="width: 66.6%;"></div>
              </div>
              <span class="w-3 text-right font-bold text-slate-800">4</span>
            </div>

            <!-- 4 stars -->
            <div class="flex items-center gap-3">
              <span class="w-12 text-slate-500">4 stars</span>
              <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
                <div class="h-full bg-[#ff4757] rounded-full" style="width: 33.3%;"></div>
              </div>
              <span class="w-3 text-right font-bold text-slate-800">2</span>
            </div>

            <!-- 3 stars -->
            <div class="flex items-center gap-3">
              <span class="w-12 text-slate-500">3 stars</span>
              <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
                <div class="h-full bg-[#ff4757] rounded-full" style="width: 0%;"></div>
              </div>
              <span class="w-3 text-right text-slate-400">0</span>
            </div>

            <!-- 2 stars -->
            <div class="flex items-center gap-3">
              <span class="w-12 text-slate-500">2 stars</span>
              <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
                <div class="h-full bg-[#ff4757] rounded-full" style="width: 0%;"></div>
              </div>
              <span class="w-3 text-right text-slate-400">0</span>
            </div>

            <!-- 1 star -->
            <div class="flex items-center gap-3">
              <span class="w-12 text-slate-500">1 star</span>
              <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
                <div class="h-full bg-[#ff4757] rounded-full" style="width: 0%;"></div>
              </div>
              <span class="w-3 text-right text-slate-400">0</span>
            </div>
          </div>
        </div>

        <!-- 3. Your Impact Card -->
        <div class="bg-white rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] p-6 space-y-4">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-heart text-sm text-[#ff4757]"></i>
            <div>
              <h3 class="text-xs font-extrabold text-slate-900 leading-tight">Your Impact</h3>
              <p class="text-[10px] text-slate-400">Your reviews help fellow travelers make better decisions.</p>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-2 pt-1 text-center">
            <div class="p-2.5 rounded-2xl bg-[#fafbfc] border border-slate-100 space-y-1">
              <i class="fa-solid fa-users text-xs text-[#ff4757]"></i>
              <span class="text-sm font-extrabold text-slate-900 block leading-none">128</span>
              <span class="text-[9px] text-slate-400 font-semibold block leading-tight">People Helped</span>
            </div>

            <div class="p-2.5 rounded-2xl bg-[#fafbfc] border border-slate-100 space-y-1">
              <i class="fa-solid fa-location-dot text-xs text-[#ff4757]"></i>
              <span class="text-sm font-extrabold text-slate-900 block leading-none">6</span>
              <span class="text-[9px] text-slate-400 font-semibold block leading-tight">Destinations</span>
            </div>

            <div class="p-2.5 rounded-2xl bg-[#fafbfc] border border-slate-100 space-y-1">
              <i class="fa-solid fa-star text-xs text-[#ff4757]"></i>
              <span class="text-sm font-extrabold text-slate-900 block leading-none">6</span>
              <span class="text-[9px] text-slate-400 font-semibold block leading-tight">Total Reviews</span>
            </div>
          </div>
        </div>

      </aside>

    </div>

  </div>

  <!-- POPUP MODAL: EDIT REVIEW -->
  <div id="editReviewModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-7 shadow-2xl border border-slate-100 space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div>
          <h4 class="text-sm font-extrabold text-slate-900">Edit Review</h4>
          <span id="modalReviewListingTitle" class="text-xs text-slate-400">Property Title</span>
        </div>
        <button type="button" onclick="closeEditReviewModal()" class="text-slate-400 hover:text-slate-600 text-xs cursor-pointer">✕</button>
      </div>

      <form id="editReviewForm" class="space-y-4">
        <input type="hidden" id="modalReviewId">

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Your Rating</label>
          <select id="modalReviewRating" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-bold text-slate-800 focus:outline-none focus:border-[#ff4757]">
            <option value="5.0">★★★★★ (5.0 Stars)</option>
            <option value="4.5">★★★★½ (4.5 Stars)</option>
            <option value="4.0">★★★★☆ (4.0 Stars)</option>
            <option value="3.5">★★★½☆ (3.5 Stars)</option>
            <option value="3.0">★★★☆☆ (3.0 Stars)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Your Review</label>
          <textarea id="modalReviewComment" rows="4" required class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs text-slate-800 focus:outline-none focus:border-[#ff4757] leading-relaxed resize-none"></textarea>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button type="button" onclick="closeEditReviewModal()" class="px-4 py-2 rounded-full border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50 cursor-pointer">Cancel</button>
          <button type="submit" class="px-5 py-2 rounded-full text-xs font-bold text-white bg-gradient-to-r from-[#ff4757] to-[#ff6b81] hover:brightness-105 shadow-md shadow-[#ff4757]/30 cursor-pointer">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

</div>

<!-- Client-side Interactive Filter & Edit Modal Script -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const cards = document.querySelectorAll(".review-item-card");

    // Tab Filter
    window.filterReviewTab = function(type, btn) {
      document.querySelectorAll(".r-tab-pill").forEach(p => {
        p.className = "r-tab-pill flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-all shrink-0 cursor-pointer";
        const icon = p.querySelector("i");
        if(icon) icon.className = icon.className.replace("text-[#ff4757]", "text-slate-400");
      });

      btn.className = "r-tab-pill flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-[#ff4757] bg-rose-50/70 border border-rose-100 transition-all shrink-0 cursor-pointer";
      const activeIcon = btn.querySelector("i");
      if(activeIcon) activeIcon.className = activeIcon.className.replace("text-slate-400", "text-[#ff4757]");

      cards.forEach(card => {
        const itemType = card.dataset.type || "";
        if (type === "all" || itemType.toLowerCase() === type.toLowerCase()) {
          card.classList.remove("hidden");
        } else {
          card.classList.add("hidden");
        }
      });
    };

    // Modal Handlers
    const modal = document.getElementById("editReviewModal");
    const modalId = document.getElementById("modalReviewId");
    const modalTitle = document.getElementById("modalReviewListingTitle");
    const modalRating = document.getElementById("modalReviewRating");
    const modalComment = document.getElementById("modalReviewComment");
    const editForm = document.getElementById("editReviewForm");

    window.openEditReviewModal = function(id, title, rating, comment) {
      modalId.value = id;
      modalTitle.textContent = title;
      modalRating.value = Number(rating).toFixed(1);
      modalComment.value = comment;
      modal.classList.remove("hidden");
    };

    document.querySelectorAll(".edit-review-btn").forEach((button) => {
      button.addEventListener("click", () => {
        const { reviewId, reviewTitle, reviewRating, reviewComment } = button.dataset;
        window.openEditReviewModal(reviewId, reviewTitle, Number(reviewRating), reviewComment);
      });
    });

    window.closeEditReviewModal = function() {
      modal.classList.add("hidden");
    };

    if (editForm) {
      editForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const id = modalId.value;
        const rating = modalRating.value;
        const comment = modalComment.value;

        try {
          const res = await fetch("/api/reviews/update", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id, rating, comment })
          });

          const data = await res.json();
          if (data.success) {
            const card = document.querySelector(`.review-item-card[data-id="${id}"]`);
            if (card) {
              const p = card.querySelector(".review-comment-text");
              if (p) p.textContent = comment;
            }
            closeEditReviewModal();
            showReviewToast("Review updated successfully.");
          }
        } catch (err) {
          // Client optimistic update
          const card = document.querySelector(`.review-item-card[data-id="${id}"]`);
          if (card) {
            const p = card.querySelector(".review-comment-text");
            if (p) p.textContent = comment;
          }
          closeEditReviewModal();
          showReviewToast("Review updated successfully.");
        }
      });
    }

    function showReviewToast(message) {
      const toast = document.createElement("div");
      toast.className = "fixed top-24 left-1/2 transform -translate-x-1/2 z-[100] px-5 py-3 rounded-2xl shadow-xl flex items-center gap-2.5 text-xs font-semibold backdrop-blur-md bg-emerald-600 text-white transition-all duration-300";
      toast.innerHTML = `<i class="fa-solid fa-circle-check text-sm"></i><span>${message}</span>`;
      document.body.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = "0";
        toast.style.transform = "translate(-50%, -15px)";
        setTimeout(() => toast.remove(), 350);
      }, 3000);
    }
  });
</script>